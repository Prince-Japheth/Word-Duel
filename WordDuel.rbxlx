---------------------------------------------------------------- helpers
-- starting clock for a match between players of this (average) level
function Config.StartClockForLevel(level)
	return math.max(Config.StartTurnTimeMin, Config.StartTurnTime - (math.max(1, level) - 1) * Config.StartSpeedupPerLevel)
end

-- clock for move number `volley` of a match that started at `start` seconds
function Config.TurnTime(volley, start)
	start = start or Config.StartTurnTime
	return Config.MinTurnTime + (start - Config.MinTurnTime) * math.exp(-volley / Config.ClockEase)
end

-- after a win you keep your momentum: the next challenger starts near your winning pace
function Config.KingStartClock(finalClock, level)
	return math.clamp((finalClock or Config.StartTurnTime) + Config.KingMomentumBonus, Config.MinTurnTime + 1.5, Config.StartClockForLevel(level))
end

-- level 1-4: 3 letters, 5-14: 4, 15-29: 5, 30+: 6
function Config.LengthForLevel(level)
	if level < 5 then
		return 3
	elseif level < 15 then
		return 4
	elseif level < 30 then
		return 5
	end
	return 6
end

function Config.XPToNext(level)
	return 100 + (level - 1) * 25
end

function Config.RankFor(elo)
	local best = Config.Ranks[1]
	for _, r in ipairs(Config.Ranks) do
		if elo >= r.min then
			best = r
		end
	end
	return best
end

function Config.SlotsFor(level, slotsBought)
	local earned = 1
	for slot = 2, Config.MaxSlots do
		if level >= Config.SlotLevels[slot] then
			earned = slot
		end
	end
	local base = math.min(Config.MaxSlots, math.max(earned, 1 + (slotsBought or 0)))
	local maxBase = (Config.AbsoluteMaxSlots or 9) - #Config.FastSlotClocks
	return math.min(maxBase, base)
end

function Config.ProductByKey(key)
	for _, p in ipairs(Config.Products) do
		if p.key == key then
			return p
		end
	end
	return nil
end

function Config.ProductById(id)
	for _, p in ipairs(Config.Products) do
		if p.id ~= 0 and p.id == id then
			return p
		end
	end
	return nil
end

Config.BiblicalWords = {
	jesus = true, christ = true, god = true, lord = true,
	faith = true, grace = true, cross = true, holy = true,
	bible = true, pray = true, prayer = true, amen = true,
	savior = true, mercy = true, glory = true, heaven = true,
	angel = true, gospel = true, psalm = true, pastor = true,
	prophet = true, zion = true, trinity = true, redeem = true,
	shiloh = true, messiah = true, judah = true, eden = true,
	noah = true, moses = true, elijah = true, isaiah = true,
	daniel = true, blessed = true, blessing = true, hallelujah = true,
}

function Config.IsBiblical(word)
	return word ~= nil and Config.BiblicalWords[string.lower(word)] == true
end

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">WordRules</string><ProtectedString name="Source"><![CDATA[-- Pure word helpers shared by server and client.
local WordRules = {}

function WordRules.Normalize(text)
	if type(text) ~= "string" then
		return nil
	end
	local w = string.lower((text:gsub("%s", "")))
	if #w < 2 or #w > 10 or w:find("[^a-z]") then
		return nil
	end
	return w
end

-- returns number of differing positions and list of changed indices (same length only)
function WordRules.Diff(a, b)
	if #a ~= #b then
		return math.huge, {}
	end
	local changed = {}
	for i = 1, #a do
		if a:sub(i, i) ~= b:sub(i, i) then
			table.insert(changed, i)
		end
	end
	return #changed, changed
end

-- Duel scoring: letters kept in the same spot, plus letters added on the end.
-- CAT -> CATER = 3 kept + 2 added = 5; TREAD -> STEAL = 2; CATER -> CAT = 3.
-- Returns kept, points. A move is legal only if kept >= 1.
function WordRules.Points(prev, w)
	local kept = 0
	for i = 1, math.min(#prev, #w) do
		if prev:sub(i, i) == w:sub(i, i) then
			kept += 1
		end
	end
	return kept, kept + math.max(0, #w - #prev)
end

-- Vowel / consonant helpers
local VOWELS = { a = true, e = true, i = true, o = true, u = true }
local function isConsonant(ch)
	return ch:match("[a-z]") and not VOWELS[ch]
end

----------------------------------------------------------------
-- Inflection check (base -> derived):
-- Regular plural/past/continuous: cats, boxes, baked, jumped, -ing, y-to-ies/ied, doubled consonants
----------------------------------------------------------------
local function inflectsForward(base, derived)
	-- standard plural / past tense: cats, boxes, baked, jumped
	if derived == base .. "s" or derived == base .. "es" or derived == base .. "d" or derived == base .. "ed" then
		return true
	end
	-- y -> ies / ied: try -> tries / tried
	if base:sub(-1) == "y" and #base >= 2 then
		local stem = base:sub(1, -2)
		if derived == stem .. "ies" or derived == stem .. "ied" then
			return true
		end
	end
	-- doubled final consonant + ed: stop -> stopped
	if #base >= 2 and isConsonant(base:sub(-1)) then
		if derived == base .. base:sub(-1) .. "ed" then
			return true
		end
	end
	-- silent-e drop: humble -> humbled / humbling, dance -> danced / dancer
	if base:sub(-1) == "e" and #base >= 3 then
		local stem = base:sub(1, -2)
		if derived == stem .. "ed" or derived == stem .. "ing" or derived == stem .. "er" or derived == stem .. "ers" then
			return true
		end
	end
	return false
end

-- Extract candidate stems/roots for a word to detect tense/plural/derivation switching
-- (e.g. settles <-> settled, danced <-> dancing, jumped <-> jumps)
local function candidateStems(w)
	local stems = { [w] = true }
	local len = #w
	if len <= 3 then
		return stems
	end
	-- ends in 's' (settles -> settle, cats -> cat, boxes -> box, tries -> try)
	if w:sub(-1) == "s" then
		stems[w:sub(1, -2)] = true
		if w:sub(-2) == "es" and len >= 4 then
			stems[w:sub(1, -3)] = true
		end
		if w:sub(-3) == "ies" and len >= 4 then
			stems[w:sub(1, -4) .. "y"] = true
		end
	end
	-- ends in 'd' (settled -> settle, baked -> bake, jumped -> jump, stopped -> stop, tried -> try)
	if w:sub(-1) == "d" then
		stems[w:sub(1, -2)] = true
		if w:sub(-2) == "ed" and len >= 4 then
			stems[w:sub(1, -3)] = true
			stems[w:sub(1, -3) .. "e"] = true
			if len >= 5 and isConsonant(w:sub(-3, -3)) and w:sub(-3, -3) == w:sub(-4, -4) then
				stems[w:sub(1, -4)] = true
			end
		end
		if w:sub(-3) == "ied" and len >= 4 then
			stems[w:sub(1, -4) .. "y"] = true
		end
	end
	-- ends in 'ing' (settling -> settle, jumping -> jump, dancing -> dance, stopping -> stop)
	if len >= 5 and w:sub(-3) == "ing" then
		stems[w:sub(1, -4)] = true
		stems[w:sub(1, -4) .. "e"] = true
		if len >= 6 and isConsonant(w:sub(-4, -4)) and w:sub(-4, -4) == w:sub(-5, -5) then
			stems[w:sub(1, -5)] = true
		end
	end
	-- ends in 'er' (dancer -> dance, jumper -> jump, runner -> run)
	if len >= 4 and w:sub(-2) == "er" then
		stems[w:sub(1, -3)] = true
		stems[w:sub(1, -3) .. "e"] = true
		if len >= 5 and isConsonant(w:sub(-3, -3)) and w:sub(-3, -3) == w:sub(-4, -4) then
			stems[w:sub(1, -4)] = true
		end
	end
	-- ends in 'ers' (dancers -> dance, runners -> run)
	if len >= 5 and w:sub(-3) == "ers" then
		stems[w:sub(1, -4)] = true
		stems[w:sub(1, -4) .. "e"] = true
		if len >= 6 and isConsonant(w:sub(-4, -4)) and w:sub(-4, -4) == w:sub(-5, -5) then
			stems[w:sub(1, -5)] = true
		end
	end
	-- ends in 'ly' (quickly -> quick, happily -> happy)
	if len >= 4 and w:sub(-2) == "ly" then
		stems[w:sub(1, -3)] = true
		if len >= 5 and w:sub(-3) == "ily" then
			stems[w:sub(1, -4) .. "y"] = true
		end
	end
	return stems
end

function WordRules.SharesStem(a, b)
	if a == b then
		return true
	end
	local stemsA = candidateStems(a)
	local stemsB = candidateStems(b)
	for sA in pairs(stemsA) do
		if #sA >= 3 and stemsB[sA] then
			return true
		end
	end
	return false
end

-- Bidirectional inflection check: base -> derived OR derived -> base OR shared stem (settles <-> settled)
function WordRules.IsInflection(prev, w)
	return inflectsForward(prev, w) or inflectsForward(w, prev) or WordRules.SharesStem(prev, w)
end

----------------------------------------------------------------
-- Suffix manipulation ban: blocks lazy tense/derivation moves
-- (e.g., dance <-> dancer, jacker <-> jackers, quick <-> quickly, profession <-> professional).
-- Only blocks grammatical tenses/plurals and direct derivational forms (-ing, -ers, -er, -ed, -es, -ly, -al, -s, -d).
-- Does NOT block natural vocabulary changes like rat -> ratty.
----------------------------------------------------------------

local SUFFIXES = {
	"ing", "ers", "er", "ed", "es", "ly", "al", "s", "d",
}

-- Check if `derived` is `base` + one suffix (handling spelling transformations)
local function suffixForward(base, derived)
	if #derived <= #base then
		return false
	end
	for _, sfx in ipairs(SUFFIXES) do
		-- direct append: profession + al = professional, jacker + s = jackers
		if derived == base .. sfx then
			return true
		end
		-- silent-e drop: dance + ing = dancing, dance + er = dancer, humble + ing = humbling
		if base:sub(-1) == "e" and VOWELS[sfx:sub(1, 1)] then
			if derived == base:sub(1, -2) .. sfx then
				return true
			end
		end
		-- consonant doubling: run + ing = running, stop + ed = stopped
		if #base >= 2 and isConsonant(base:sub(-1)) then
			if derived == base .. base:sub(-1) .. sfx then
				return true
			end
		end
		-- y -> i conversion: happy -> happily, baby -> babies
		if base:sub(-1) == "y" and #base >= 2 then
			local stem = base:sub(1, -2)
			if derived == stem .. "i" .. sfx then
				return true
			end
			if sfx == "s" and derived == stem .. "ies" then
				return true
			end
		end
	end
	return false
end

-- Bidirectional: is the move just adding OR removing a suffix?
function WordRules.IsSuffixManipulation(prev, w)
	return suffixForward(prev, w) or suffixForward(w, prev)
end

function WordRules.IsRare(word, rareLetters)
	for i = 1, #word do
		if rareLetters[word:sub(i, i)] then
			return true
		end
	end
	return false
end

return WordRules
]]></ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX00000012"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX00000005"><Properties><string name="Name">Server</string></Properties><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Ambient</string><ProtectedString name="Source"><![CDATA[-- Ambient: NPC duels at tables nobody is using, so the hall never looks empty.
-- A real match always takes priority: Lobby calls Ambient.Stop(table) before using it.
local Players = game:GetService("Players")
local Arena = require(script.Parent.Arena)
local Dictionary = require(script.Parent.Dictionary)
local NPC = require(script.Parent.NPC)

local Ambient = {}
local running = {} -- [table] = { rigs = {}, alive = true }

function Ambient.Stop(tbl)
	local run = running[tbl]
	if not run then
		return
	end
	running[tbl] = nil
	run.alive = false
	for _, rig in ipairs(run.rigs) do
		rig:Destroy()
	end
	Arena.ClearSeats(tbl)
	Arena.SetTimer(tbl, nil)
	Arena.SetClock(tbl, 0)
	Arena.SetDisplay(tbl, nil, nil)
end

function Ambient.IsRunning(tbl)
	return running[tbl] ~= nil
end

function Ambient.Start(tbl)
	if running[tbl] or tbl.busy then
		return
	end
	-- Real player safety check: never spawn NPCs if a player is at or assigned to this table
	for side = 1, 2 do
		if tbl.assigned and tbl.assigned[side] then
			local a = tbl.assigned[side]
			if typeof(a) == "Instance" and a:IsA("Player") then
				return
			end
		end
		local seat = tbl.seats and tbl.seats[side]
		if seat and seat.Occupant then
			local plr = Players:GetPlayerFromCharacter(seat.Occupant.Parent)
			if plr then
				return
			end
		end
	end
	local run = { rigs = {}, alive = true }
	running[tbl] = run
	task.spawn(function()
		local names = { NPC.RandomName(), NPC.RandomName() }
		for side = 1, 2 do
			local rig = NPC.Build(names[side])
			if not run.alive then
				if rig then
					rig:Destroy()
				end
				return
			end
			if rig then
				table.insert(run.rigs, rig)
				Arena.SeatRig(tbl, side, rig)
			end
		end
		while run.alive do
			-- one ambient "game": a short rally on a fresh word
			local word = Dictionary.StartWord(math.random(3, 5))
			local used = { [word] = true }
			local side = math.random(2)
			Arena.SetDisplay(tbl, word, names[1] .. "  vs  " .. names[2])
			local rally = math.random(6, 18)
			for _ = 1, rally do
				if not run.alive then
					return
				end
				local think = 1.5 + math.random() * 4
				Arena.SetClock(tbl, side)
				Arena.SetTimer(tbl, workspace:GetServerTimeNow() + think + math.random() * 5)
				task.wait(think)
				if not run.alive then
					return
				end
				local w = Dictionary.PickMove(word, 1, used, nil)
				if not w then
					break
				end
				used[w] = true
				word = w
				Arena.SetDisplay(tbl, word, names[1] .. "  vs  " .. names[2])
				side = 3 - side
			end
			Arena.SetTimer(tbl, nil)
			Arena.SetClock(tbl, 0)
			task.wait(3 + math.random() * 3)
		end
	end)
end

-- fill every free table, staggered so they don't all change in lockstep
function Ambient.FillAll()
	for i, tbl in ipairs(Arena.Tables) do
		task.delay(i * 0.7, function()
			if not tbl.busy then
				Ambient.Start(tbl)
			end
		end)
	end
end

return Ambient
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Arena</string><ProtectedString name="Source"><![CDATA[-- Arena: the tournament hall. A walled room with duel tables; each table has its own
-- game set (felt top, a rack of 3D letter tiles showing the live word, a duel clock,
-- a letter bag and a brass bell). Built from plain parts, no custom assets.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Arena = {}

local folder = Instance.new("Folder")
folder.Name = "WordDuelArena"
folder.Parent = workspace

local MONT = Font.new("rbxasset://fonts/families/Montserrat.json", Enum.FontWeight.Heavy)
local BUILDER = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)

local function part(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do
		p[k] = v
	end
	return p
end

local function surfaceText(p, face, text, props)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = props.pps or 50
	sg.LightInfluence = props.light or 0.4
	sg.Parent = p
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = UDim2.fromScale(1, 1)
	l.FontFace = props.font or MONT
	l.TextScaled = true
	l.TextColor3 = props.color or Color3.fromRGB(28, 26, 34)
	l.Text = text
	l.Parent = sg
	if props.pad then
		local u = Instance.new("UIPadding")
		u.PaddingTop = UDim.new(props.pad, 0)
		u.PaddingBottom = UDim.new(props.pad, 0)
		u.PaddingLeft = UDim.new(props.pad, 0)
		u.PaddingRight = UDim.new(props.pad, 0)
		u.Parent = l
	end
	return l, sg
end

---------------------------------------------------------------- mood
do
	local Lighting = game:GetService("Lighting")
	Lighting.ClockTime = 16.8
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(92, 80, 88)
	Lighting.OutdoorAmbient = Color3.fromRGB(128, 112, 116)
	Lighting.ExposureCompensation = 0.35
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.4
	pcall(function()
		Lighting.Technology = Enum.Technology.Future
	end)
	for _, ch in ipairs(Lighting:GetChildren()) do
		if ch:IsA("Atmosphere") or ch:IsA("PostEffect") then
			ch:Destroy()
		end
	end
	local atmo = Instance.new("Atmosphere")
	atmo.Density = 0.24
	atmo.Offset = 0.1
	atmo.Color = Color3.fromRGB(220, 190, 160)
	atmo.Decay = Color3.fromRGB(150, 120, 120)
	atmo.Glare = 0.2
	atmo.Haze = 1.6
	atmo.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Contrast = 0.08
	cc.Saturation = 0.06
	cc.TintColor = Color3.fromRGB(255, 244, 232)
	cc.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.5
	bloom.Size = 28
	bloom.Threshold = 1.4
	bloom.Parent = Lighting
end

---------------------------------------------------------------- the hall
-- interior: x -62..62, z -80..46
local HALL_MIN, HALL_MAX = Vector3.new(-62, 0, -80), Vector3.new(62, 0, 46)
local center = (HALL_MIN + HALL_MAX) / 2
local sizeX, sizeZ = HALL_MAX.X - HALL_MIN.X, HALL_MAX.Z - HALL_MIN.Z

part({ Name = "Floor", Size = Vector3.new(sizeX + 8, 1, sizeZ + 8), Position = Vector3.new(center.X, -0.5, center.Z), Material = Enum.Material.WoodPlanks, Color = Color3.fromRGB(132, 94, 66), Parent = folder })
part({ Name = "Rug", Size = Vector3.new(118, 0.1, 64), Position = Vector3.new(0, 0.05, 8), Material = Enum.Material.Fabric, Color = Color3.fromRGB(122, 40, 46), CanCollide = false, Parent = folder })
part({ Name = "RugBorder", Size = Vector3.new(121, 0.08, 67), Position = Vector3.new(0, 0.04, 8), Material = Enum.Material.Fabric, Color = Color3.fromRGB(196, 150, 70), CanCollide = false, Parent = folder })

local WALL_H = 28
local function wall(name, size, pos)
	-- dark wood wainscot below, warm plaster above, a brass rail between
	part({ Name = name .. "Upper", Size = Vector3.new(size.X, WALL_H, size.Z), Position = pos + Vector3.new(0, WALL_H / 2, 0), Material = Enum.Material.Plaster, Color = Color3.fromRGB(150, 120, 104), Parent = folder })
	local inset = (size.X > size.Z) and Vector3.new(0, 0, 0.3) or Vector3.new(0.3, 0, 0)
	part({ Name = name .. "Panel", Size = Vector3.new(size.X + 0.6, 7, size.Z + 0.6), Position = pos + Vector3.new(0, 3.5, 0), Material = Enum.Material.Wood, Color = Color3.fromRGB(70, 44, 30), Parent = folder })
	part({ Name = name .. "Rail", Size = Vector3.new(size.X + 0.9, 0.35, size.Z + 0.9), Position = pos + Vector3.new(0, 7.1, 0), Material = Enum.Material.Metal, Color = Color3.fromRGB(196, 150, 70), Parent = folder })
	return inset
end
wall("WallN", Vector3.new(sizeX + 4, 0, 2), Vector3.new(center.X, 0, HALL_MAX.Z + 1))
wall("WallS", Vector3.new(sizeX + 4, 0, 2), Vector3.new(center.X, 0, HALL_MIN.Z - 1))
wall("WallE", Vector3.new(2, 0, sizeZ + 4), Vector3.new(HALL_MAX.X + 1, 0, center.Z))
wall("WallW", Vector3.new(2, 0, sizeZ + 4), Vector3.new(HALL_MIN.X - 1, 0, center.Z))
-- invisible lid so nobody climbs out
part({ Name = "Lid", Size = Vector3.new(sizeX + 4, 1, sizeZ + 4), Position = Vector3.new(center.X, WALL_H + 0.5, center.Z), Transparency = 1, Parent = folder })

-- columns with sconces
for _, x in ipairs({ HALL_MIN.X + 1.5, HALL_MAX.X - 1.5 }) do
	for z = HALL_MIN.Z + 14, HALL_MAX.Z - 6, 22 do
		part({ Name = "Column", Size = Vector3.new(3, WALL_H, 3), Position = Vector3.new(x, WALL_H / 2, z), Material = Enum.Material.Wood, Color = Color3.fromRGB(58, 36, 24), Parent = folder })
		local lamp = part({ Name = "Sconce", Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 1.2, 1.2), Position = Vector3.new(x + (x < 0 and 1.8 or -1.8), 12, z), Material = Enum.Material.Neon, Color = Color3.fromRGB(255, 200, 140), CanCollide = false, Parent = folder })
		local l = Instance.new("PointLight")
		l.Range = 18
		l.Brightness = 1.4
		l.Color = Color3.fromRGB(255, 200, 150)
		l.Parent = lamp
	end
end

-- big title banner on the far wall, made of letter tiles
do
	local word = "WORD DUEL"
	local tileSize, gap = 5.2, 0.8
	local width = #word * (tileSize + gap)
	local x0 = -width / 2 + tileSize / 2
	for i = 1, #word do
		local ch = word:sub(i, i)
		if ch ~= " " then
			local amber = i > 5
			local t = part({
				Name = "BannerTile",
				Size = Vector3.new(tileSize, tileSize, 0.6),
				Position = Vector3.new(x0 + (i - 1) * (tileSize + gap), 15 + ((i % 2 == 0) and 0.4 or -0.4), HALL_MAX.Z - 0.4),
				Color = amber and Color3.fromRGB(255, 186, 74) or Color3.fromRGB(247, 238, 216),
				Material = Enum.Material.SmoothPlastic,
				Parent = folder,
			})
			t.Orientation = Vector3.new(0, 180, (i % 3 - 1) * 3)
			surfaceText(t, Enum.NormalId.Front, ch, { pad = 0.12, light = 0.2 })
		end
	end
	local sub = part({ Name = "BannerSub", Size = Vector3.new(40, 2, 0.2), Position = Vector3.new(0, 10.2, HALL_MAX.Z - 0.3), Transparency = 1, CanCollide = false, Parent = folder })
	sub.Orientation = Vector3.new(0, 180, 0)
	surfaceText(sub, Enum.NormalId.Front, "KEEP A LETTER IN PLACE.  BEAT THE CLOCK.", { font = BUILDER, color = Color3.fromRGB(255, 236, 210), light = 0 })
end

local spawn = Instance.new("SpawnLocation")
spawn.Anchored = true
spawn.Size = Vector3.new(10, 0.2, 10)
spawn.CFrame = CFrame.lookAt(Vector3.new(0, 0.1, -60), Vector3.new(0, 0.1, 0))
spawn.Transparency = 1
spawn.CanCollide = false
spawn.Neutral = true
spawn.Duration = 0
spawn.Parent = folder
for _, d in ipairs(spawn:GetChildren()) do
	if d:IsA("Decal") then
		d:Destroy()
	end
end
Arena.LobbyCFrame = CFrame.lookAt(Vector3.new(0, 4, -55), Vector3.new(0, 4, 0))

---------------------------------------------------------------- duel tables
Arena.Tables = {}
local MAX_TILES = 10
local TILE = 0.95
local TABLE_TOP = 3.4

local function buildTable(index, origin)
	local model = Instance.new("Model")
	model.Name = "Table" .. index
	model.Parent = folder

	local wood = Color3.fromRGB(64, 38, 24)
	local brass = Color3.fromRGB(196, 150, 70)
	-- pedestal + round top with brass rim and green felt
	part({ Name = "Base", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 3.6, 3.6), Position = origin + Vector3.new(0, 0.2, 0), Orientation = Vector3.new(0, 0, 90), Color = wood, Material = Enum.Material.Wood, Parent = model })
	part({ Name = "Leg", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 1.1, 1.1), Position = origin + Vector3.new(0, 1.7, 0), Orientation = Vector3.new(0, 0, 90), Color = wood, Material = Enum.Material.Wood, Parent = model })
	part({ Name = "Rim", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.35, 8.6, 8.6), Position = origin + Vector3.new(0, TABLE_TOP - 0.25, 0), Orientation = Vector3.new(0, 0, 90), Color = brass, Material = Enum.Material.Metal, Parent = model })
	part({ Name = "Top", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 8.2, 8.2), Position = origin + Vector3.new(0, TABLE_TOP - 0.2, 0), Orientation = Vector3.new(0, 0, 90), Color = wood, Material = Enum.Material.Wood, Parent = model })
	part({ Name = "Felt", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.05, 7, 7), Position = origin + Vector3.new(0, TABLE_TOP + 0.02, 0), Orientation = Vector3.new(0, 0, 90), Color = Color3.fromRGB(24, 74, 56), Material = Enum.Material.Fabric, CanCollide = false, Parent = model })

	-- word rack across the middle, tiles stand in it (letters on both faces)
	local rackLen = 7.4 -- fits the table; tiles shrink for long words
	part({ Name = "Rack", Size = Vector3.new(rackLen, 0.35, 0.9), Position = origin + Vector3.new(0, TABLE_TOP + 0.2, 0), Color = Color3.fromRGB(92, 58, 34), Material = Enum.Material.Wood, Parent = model })
	part({ Name = "RackLip", Size = Vector3.new(rackLen, 0.12, 0.95), Position = origin + Vector3.new(0, TABLE_TOP + 0.4, 0), Color = brass, Material = Enum.Material.Metal, Parent = model })
	local tiles = {}
	for i = 1, MAX_TILES do
		local x = (i - (MAX_TILES + 1) / 2) * (TILE + 0.12)
		local t = part({
			Name = "Tile" .. i,
			Size = Vector3.new(TILE, TILE, 0.24),
			Position = origin + Vector3.new(x, TABLE_TOP + 0.95, 0),
			Color = Color3.fromRGB(247, 238, 216),
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			Transparency = 1,
			Parent = model,
		})
		local front, sgF = surfaceText(t, Enum.NormalId.Front, "", { pad = 0.1 })
		local back, sgB = surfaceText(t, Enum.NormalId.Back, "", { pad = 0.1 })
		sgF.Enabled = false
		sgB.Enabled = false
		tiles[i] = { part = t, labels = { front, back }, guis = { sgF, sgB }, home = t.CFrame, letter = nil }
	end

	-- duel clock: a wooden box with a lit display on each side and two plunger buttons
	local clock = part({ Name = "Clock", Size = Vector3.new(1.8, 0.9, 0.9), Position = origin + Vector3.new(2.6, TABLE_TOP + 0.45, 0), Color = Color3.fromRGB(40, 26, 18), Material = Enum.Material.Wood, Parent = model })
	local screen = part({ Name = "ClockScreen", Size = Vector3.new(1.3, 0.55, 0.95), Position = clock.Position + Vector3.new(0, 0.05, 0), Color = Color3.fromRGB(16, 18, 24), Material = Enum.Material.SmoothPlastic, Parent = model })
	local clockLabels = {}
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local l = surfaceText(screen, face, "--", { color = Color3.fromRGB(255, 186, 74), light = 0, pad = 0.08 })
		table.insert(clockLabels, l)
	end
	local btnA = part({ Name = "ButtonA", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 0.45, 0.45), Position = clock.Position + Vector3.new(0, 0.6, -0.25), Orientation = Vector3.new(0, 0, 90), Color = Color3.fromRGB(60, 60, 60), Parent = model })
	local btnB = part({ Name = "ButtonB", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 0.45, 0.45), Position = clock.Position + Vector3.new(0, 0.6, 0.25), Orientation = Vector3.new(0, 0, 90), Color = Color3.fromRGB(60, 60, 60), Parent = model })

	-- letter bag + brass bell + score pads
	part({ Name = "LetterBag", Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 1.2, 1.2), Position = origin + Vector3.new(-2.6, TABLE_TOP + 0.55, 0.9), Color = Color3.fromRGB(96, 40, 110), Material = Enum.Material.Fabric, CanCollide = false, Parent = model })
	part({ Name = "BagTie", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.35, 0.5, 0.5), Position = origin + Vector3.new(-2.6, TABLE_TOP + 1.15, 0.9), Orientation = Vector3.new(0, 0, 90), Color = brass, Material = Enum.Material.Fabric, CanCollide = false, Parent = model })
	part({ Name = "SpillTile", Size = Vector3.new(0.6, 0.12, 0.6), Position = origin + Vector3.new(-1.9, TABLE_TOP + 0.08, 1.5), Orientation = Vector3.new(0, 25, 0), Color = Color3.fromRGB(247, 238, 216), CanCollide = false, Parent = model })
	part({ Name = "BellBase", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.12, 0.7, 0.7), Position = origin + Vector3.new(-2.6, TABLE_TOP + 0.08, -1.1), Orientation = Vector3.new(0, 0, 90), Color = Color3.fromRGB(30, 30, 34), Material = Enum.Material.Metal, CanCollide = false, Parent = model })
	part({ Name = "Bell", Shape = Enum.PartType.Ball, Size = Vector3.new(0.6, 0.6, 0.6), Position = origin + Vector3.new(-2.6, TABLE_TOP + 0.3, -1.1), Color = brass, Material = Enum.Material.Metal, Reflectance = 0.15, CanCollide = false, Parent = model })
	for _, z in ipairs({ -2.7, 2.7 }) do
		local pad = part({ Name = "ScorePad", Size = Vector3.new(1.6, 0.05, 1.1), Position = origin + Vector3.new(1.2, TABLE_TOP + 0.05, z), Orientation = Vector3.new(0, z < 0 and 8 or -172, 0), Color = Color3.fromRGB(240, 232, 214), CanCollide = false, Parent = model })
		surfaceText(pad, Enum.NormalId.Top, "WORD DUEL", { font = MONT, color = Color3.fromRGB(196, 122, 26), light = 0.6, pad = 0.25 })
	end

	-- hanging lamp: warm pool of light on each table
	part({ Name = "LampCord", Size = Vector3.new(0.1, 6, 0.1), Position = origin + Vector3.new(0, 18, 0), Color = Color3.fromRGB(20, 20, 20), CanCollide = false, Parent = model })
	part({ Name = "LampShade", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8, 3, 3), Position = origin + Vector3.new(0, 14.8, 0), Orientation = Vector3.new(0, 0, 90), Color = Color3.fromRGB(28, 60, 44), Material = Enum.Material.Metal, CanCollide = false, Parent = model })
	local bulb = part({ Name = "Bulb", Shape = Enum.PartType.Ball, Size = Vector3.new(0.8, 0.8, 0.8), Position = origin + Vector3.new(0, 14.2, 0), Color = Color3.fromRGB(255, 214, 160), Material = Enum.Material.Neon, CanCollide = false, Parent = model })
	local light = Instance.new("SpotLight")
	light.Face = Enum.NormalId.Bottom
	light.Angle = 80
	light.Range = 22
	light.Brightness = 4
	light.Color = Color3.fromRGB(255, 210, 160)
	light.Shadows = true
	light.Parent = bulb

	-- seats face each other along Z
	-- Premium luxury duel chairs: midnight obsidian leather, polished gold/brass accents, dark walnut wood
	-- Completely distinct and high contrast against oak wood floor and burgundy rug
	local chairWood = Color3.fromRGB(36, 22, 14)
	local chairLeather = Color3.fromRGB(24, 28, 40)
	local chairBrass = Color3.fromRGB(218, 165, 32)

	local function makeChair(name, pos, lookTarget)
		local cf = CFrame.lookAt(pos, lookTarget)
		-- 4 walnut legs with brass ferrules
		for _, dx in ipairs({ -0.95, 0.95 }) do
			for _, dz in ipairs({ -0.95, 0.95 }) do
				part({
					Name = name .. "Leg",
					Shape = Enum.PartType.Cylinder,
					Size = Vector3.new(1.4, 0.22, 0.22),
					CFrame = cf * CFrame.new(dx, -1.05, dz) * CFrame.Angles(0, 0, math.pi / 2),
					Color = chairWood,
					Material = Enum.Material.Wood,
					Parent = model,
				})
			end
		end
		-- Walnut frame base under seat
		part({
			Name = name .. "Base",
			Size = Vector3.new(2.6, 0.2, 2.6),
			CFrame = cf * CFrame.new(0, -0.3, 0),
			Color = chairWood,
			Material = Enum.Material.Wood,
			Parent = model,
		})
		-- Polished brass accent ring below cushion
		part({
			Name = name .. "Trim",
			Size = Vector3.new(2.5, 0.1, 2.5),
			CFrame = cf * CFrame.new(0, -0.15, 0),
			Color = chairBrass,
			Material = Enum.Material.Metal,
			Parent = model,
		})
		-- Padded luxury midnight obsidian leather Seat
		local seat = Instance.new("Seat")
		seat.Name = name
		seat.Anchored = true
		seat.Size = Vector3.new(2.4, 0.6, 2.4)
		seat.CFrame = cf
		seat.Color = chairLeather
		seat.Material = Enum.Material.Leather
		seat.Parent = model
		return seat
	end

	local seatA = makeChair("SeatA", origin + Vector3.new(0, 1.8, -5), origin + Vector3.new(0, 1.8, 0))
	local seatB = makeChair("SeatB", origin + Vector3.new(0, 1.8, 5), origin + Vector3.new(0, 1.8, 0))

	-- small floating names for spectators
	local anchor = part({ Name = "Display", Size = Vector3.new(1, 1, 1), Position = origin + Vector3.new(0, 8.2, 0), Transparency = 1, CanCollide = false, Parent = model })
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromScale(11, 1.4)
	bb.LightInfluence = 0
	bb.MaxDistance = 70
	bb.Parent = anchor
	local namesLabel = Instance.new("TextLabel")
	namesLabel.Name = "Names"
	namesLabel.Size = UDim2.fromScale(1, 1)
	namesLabel.BackgroundTransparency = 1
	namesLabel.FontFace = BUILDER
	namesLabel.TextScaled = true
	namesLabel.TextColor3 = Color3.fromRGB(255, 236, 210)
	namesLabel.TextStrokeTransparency = 0.5
	namesLabel.Text = ""
	namesLabel.Parent = bb

	local t = {
		index = index,
		model = model,
		seats = { seatA, seatB },
		buttons = { btnA, btnB },
		tiles = tiles,
		clockLabels = clockLabels,
		namesLabel = namesLabel,
		busy = false,
		origin = origin,
		assigned = {},
		rigs = {},
		seatTokens = { 0, 0 },
		deadline = nil,
		rackCenter = CFrame.new(origin + Vector3.new(0, TABLE_TOP + 0.95, 0)),
		shownLen = 0,
	}
	-- only the two assigned duelists (players or NPC rigs) may sit here
	for side, seat in ipairs(t.seats) do
		seat:GetPropertyChangedSignal("Occupant"):Connect(function()
			local hum = seat.Occupant
			if not hum then
				return
			end
			local who = Players:GetPlayerFromCharacter(hum.Parent) or hum.Parent
			if who ~= t.assigned[side] then
				task.defer(function()
					if seat.Occupant == hum then
						local curWho = Players:GetPlayerFromCharacter(hum.Parent) or hum.Parent
						if curWho ~= t.assigned[side] then
							hum.Sit = false
						end
					end
				end)
			end
		end)
	end
	table.insert(Arena.Tables, t)
	return t
end

do
	local cols = 4
	for i = 1, 8 do
		local col = (i - 1) % cols
		local row = math.floor((i - 1) / cols)
		buildTable(i, Vector3.new((col - 1.5) * 26, 0, row * 26 - 5))
	end
end

---------------------------------------------------------------- API
function Arena.FreeTable()
	for _, t in ipairs(Arena.Tables) do
		if not t.busy then
			return t
		end
	end
	return nil
end

-- show `word` centered on the table's tile rack; tiles whose letter changed hop up briefly
function Arena.SetDisplay(t, word, names)
	t.namesLabel.Text = names or ""
	local len = word and #word or 0
	local relayout = len ~= t.shownLen
	t.shownLen = len
	for i, tile in ipairs(t.tiles) do
		local show = i <= len
		tile.part.Transparency = show and 0 or 1
		for _, g in ipairs(tile.guis) do
			g.Enabled = show
		end
		if show then
			local w = math.min(TILE, 7.0 / len - 0.1)
			local home = t.rackCenter * CFrame.new((i - (len + 1) / 2) * (w + 0.1), (w - TILE) / 2, 0)
			local up = string.upper(word:sub(i, i))
			if relayout then
				tile.home = home
				tile.part.Size = Vector3.new(w, w, 0.24)
				tile.part.CFrame = home
			elseif tile.letter and tile.letter ~= up then
				TweenService:Create(tile.part, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true), { CFrame = tile.home * CFrame.new(0, 0.45, 0) }):Play()
			end
			-- tiles run along +X; seat A (front faces) sees +X on its LEFT, so the front faces
			-- carry the mirrored position's letter and the back faces read normally for seat B
			tile.labels[1].Text = string.upper(word:sub(len + 1 - i, len + 1 - i))
			tile.labels[2].Text = up
			tile.letter = up
		else
			tile.letter = nil
		end
	end
end

-- side = 1 or 2: whose clock is running (0 = none)
function Arena.SetClock(t, side)
	for i, b in ipairs(t.buttons) do
		b.Color = side == i and Color3.fromRGB(230, 70, 60) or Color3.fromRGB(60, 60, 60)
		b.Material = side == i and Enum.Material.Neon or Enum.Material.SmoothPlastic
	end
end

function Arena.SetTimer(t, deadline)
	t.deadline = deadline
	if not deadline then
		for _, l in ipairs(t.clockLabels) do
			l.Text = "--"
		end
	end
end

task.spawn(function()
	while true do
		task.wait(0.25)
		local now = workspace:GetServerTimeNow()
		for _, t in ipairs(Arena.Tables) do
			if t.deadline then
				local txt = tostring(math.max(0, math.ceil(t.deadline - now)))
				for _, l in ipairs(t.clockLabels) do
					if l.Text ~= txt then
						l.Text = txt
					end
				end
			end
		end
	end
end)

local function humanoidOf(player)
	local char = player and player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function resetSeat(t, side, seat)
	local sign = (side == 1) and -1 or 1
	seat.Anchored = true
	seat.CFrame = CFrame.lookAt(t.origin + Vector3.new(0, 1.8, sign * 5), t.origin + Vector3.new(0, 1.8, 0))
end

local function clearSeatOccupant(t, side, seat, keepHum)
	if t.rigs[side] then
		if t.rigs[side].Parent then
			t.rigs[side]:Destroy()
		end
		t.rigs[side] = nil
	end
	local occ = seat.Occupant
	if occ and occ ~= keepHum then
		if not Players:GetPlayerFromCharacter(occ.Parent) then
			if occ.Parent then
				occ.Parent:Destroy()
			end
		else
			occ.Sit = false
		end
	end
	local weld = seat:FindFirstChild("SeatWeld")
	if weld and (not keepHum or seat.Occupant ~= keepHum) then
		weld:Destroy()
	end
end

function Arena.Seat(t, side, player)
	local hum = humanoidOf(player)
	if not hum then
		return
	end
	t.seatTokens[side] = (t.seatTokens[side] or 0) + 1
	local token = t.seatTokens[side]
	local seat = t.seats[side]
	t.assigned[side] = player
	hum.UseJumpPower = true
	hum.JumpPower = 0
	if player.Character then
		player.Character.Archivable = true -- lets the opponent's HUD render this avatar
	end

	-- Fast path: player is already cleanly seated in their assigned chair
	if seat.Occupant == hum and hum.SeatPart == seat and seat:FindFirstChild("SeatWeld") then
		if t.rigs[side] then
			if t.rigs[side].Parent then
				t.rigs[side]:Destroy()
			end
			t.rigs[side] = nil
		end
		seat.Anchored = true
		return
	end

	clearSeatOccupant(t, side, seat, hum)
	resetSeat(t, side, seat)

	if hum.SeatPart and hum.SeatPart ~= seat then
		local oldWeld = hum.SeatPart:FindFirstChild("SeatWeld")
		if oldWeld then
			oldWeld:Destroy()
		end
		hum.Sit = false
	end
	local root = hum.RootPart
	if root then
		for _, w in ipairs(root:GetChildren()) do
			if w:IsA("Weld") or w.Name == "SeatWeld" then
				w:Destroy()
			end
		end
	end

	local function trySit(curHum)
		local char = player.Character
		local r = curHum.RootPart
		if char then
			if r then
				r.AssemblyLinearVelocity = Vector3.zero
				r.AssemblyAngularVelocity = Vector3.zero
			end
			char:PivotTo(seat.CFrame + Vector3.new(0, 2, 0))
		end
		seat:Sit(curHum)
	end

	if not hum.Sit and not seat.Occupant then
		trySit(hum)
	end

	task.spawn(function()
		for _ = 1, 25 do
			task.wait(0.08)
			if t.seatTokens[side] ~= token or t.assigned[side] ~= player or not player.Parent then
				return
			end
			local curHum = humanoidOf(player)
			if not curHum or curHum.Health <= 0 then
				return
			end
			if seat.Occupant == curHum and curHum.SeatPart == seat then
				return
			end
			if curHum.Sit and curHum.SeatPart ~= seat then
				local oldWeld = curHum.SeatPart and curHum.SeatPart:FindFirstChild("SeatWeld")
				if oldWeld then
					oldWeld:Destroy()
				end
				curHum.Sit = false
			else
				clearSeatOccupant(t, side, seat, curHum)
				resetSeat(t, side, seat)
				trySit(curHum)
			end
		end
	end)
end

-- seat an NPC rig (bot opponent or ambient duelist)
function Arena.SeatRig(t, side, rig)
	local seat = t.seats[side]
	local hum = rig:FindFirstChildOfClass("Humanoid")
	t.seatTokens[side] = (t.seatTokens[side] or 0) + 1
	local token = t.seatTokens[side]
	if t.rigs[side] and t.rigs[side] ~= rig then
		if t.rigs[side].Parent then
			t.rigs[side]:Destroy()
		end
		t.rigs[side] = nil
	end
	clearSeatOccupant(t, side, seat, hum)
	resetSeat(t, side, seat)
	t.assigned[side] = rig
	t.rigs[side] = rig
	rig:PivotTo(seat.CFrame + Vector3.new(0, 2, 0))
	rig.Parent = folder
	if hum then
		task.spawn(function()
			for _ = 1, 30 do
				if t.seatTokens[side] ~= token or t.assigned[side] ~= rig or not rig.Parent then
					return
				end
				if seat.Occupant == hum then
					return
				end
				if not seat.Occupant then
					resetSeat(t, side, seat)
					rig:PivotTo(seat.CFrame + Vector3.new(0, 2, 0))
					seat:Sit(hum)
				end
				task.wait(0.05)
			end
		end)
	end
end

function Arena.ClearSeats(t, keep)
	for side, seat in ipairs(t.seats) do
		t.seatTokens[side] = (t.seatTokens[side] or 0) + 1
		local keepPlayer = keep and keep[side]
		local keepHum = keepPlayer and humanoidOf(keepPlayer)
		if keepPlayer and keepHum and seat.Occupant == keepHum and keepHum.SeatPart == seat and seat:FindFirstChild("SeatWeld") then
			if t.rigs[side] then
				if t.rigs[side].Parent then
					t.rigs[side]:Destroy()
				end
				t.rigs[side] = nil
			end
			t.assigned[side] = keepPlayer
			seat.Anchored = true
		else
			t.assigned[side] = nil
			clearSeatOccupant(t, side, seat)
			resetSeat(t, side, seat)
		end
	end
end

function Arena.Unseat(player)
	local hum = humanoidOf(player)
	if not hum then
		return
	end
	hum.Sit = false
	hum.JumpPower = 50
	local root = hum.RootPart
	if root then
		for _, w in ipairs(root:GetChildren()) do
			if w:IsA("Weld") or w.Name == "SeatWeld" then
				w:Destroy()
			end
		end
	end
	for _, t in ipairs(Arena.Tables) do
		for side, seat in ipairs(t.seats) do
			local weld = seat:FindFirstChild("SeatWeld")
			if weld and (seat.Occupant == hum or t.assigned[side] == player) then
				weld:Destroy()
			end
			if t.assigned[side] == player then
				t.seatTokens[side] = (t.seatTokens[side] or 0) + 1
				t.assigned[side] = nil
			end
			-- Always ensure seat is anchored and at its correct table position
			resetSeat(t, side, seat)
		end
	end
	if root then
		task.defer(function()
			if root.Parent then
				root.CFrame = Arena.LobbyCFrame + Vector3.new(math.random(-6, 6), 0, math.random(-3, 3))
			end
		end)
	end
end

local function orientCharacter(player, char)
	local root = char:WaitForChild("HumanoidRootPart", 5)
	if root then
		task.defer(function()
			if root.Parent then
				for _, t in ipairs(Arena.Tables) do
					if t.assigned[1] == player or t.assigned[2] == player then
						return
					end
				end
				root.CFrame = Arena.LobbyCFrame + Vector3.new(math.random(-4, 4), 0, math.random(-2, 2))
			end
		end)
	end
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(char)
		orientCharacter(player, char)
	end)
	if player.Character then
		orientCharacter(player, player.Character)
	end
end)
for _, player in ipairs(Players:GetPlayers()) do
	player.CharacterAdded:Connect(function(char)
		orientCharacter(player, char)
	end)
	if player.Character then
		orientCharacter(player, player.Character)
	end
end

return Arena
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">DailyLadder</string><ProtectedString name="Source"><![CDATA[-- DailyLadder: one shared solo puzzle per day. Turn START into TARGET by changing one
-- letter at a time; every step must be a real word. Par = the shortest possible chain.
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local WordRules = require(Shared.WordRules)

local Dictionary = require(script.Parent.Dictionary)
local PlayerData = require(script.Parent.PlayerData)

local DailyLadder = {}
DailyLadder.Send = nil -- function(player, action, payload)

local LEN = 4
local EPOCH_DAY = 20774 -- puzzle #1 = 2026-11-18 (UTC)

local function today()
	return math.floor(os.time() / 86400)
end

-- breadth-first distances from `from` over one-letter moves (whole dictionary)
local function distances(from)
	local dist = { [from] = 0 }
	local queue, head = { from }, 1
	while head <= #queue do
		local w = queue[head]
		head += 1
		for _, n in ipairs(Dictionary.Moves(w, 1, nil, nil)) do
			if dist[n] == nil then
				dist[n] = dist[w] + 1
				table.insert(queue, n)
			end
		end
	end
	return dist
end

local cache = {} -- [day] = puzzle

function DailyLadder.ForDay(day)
	if cache[day] then
		return cache[day]
	end
	local rng = Random.new(day * 7919 + 13)
	local list = Dictionary.StartList(LEN)
	local puzzle
	for _ = 1, 40 do
		local start = list[rng:NextInteger(1, #list)]
		if Dictionary.IsAllowed(start) then
			local dist = distances(start)
			local candidates = {}
			for _, w in ipairs(list) do
				local d = dist[w]
				if d and d >= Config.LadderMinPar and d <= Config.LadderMaxPar and Dictionary.IsAllowed(w) then
					table.insert(candidates, w)
				end
			end
			if #candidates > 0 then
				table.sort(candidates)
				local target = candidates[rng:NextInteger(1, #candidates)]
				puzzle = { day = day, number = day - EPOCH_DAY, start = start, target = target, par = dist[target] }
				break
			end
		end
	end
	puzzle = puzzle or { day = day, number = day - EPOCH_DAY, start = "cold", target = "warm", par = 4 }
	puzzle.toTarget = distances(puzzle.target) -- for hints
	cache[day] = puzzle
	return puzzle
end

function DailyLadder.Today()
	return DailyLadder.ForDay(today())
end

---------------------------------------------------------------- per-player session
local sessions = {} -- [player] = { day, chain = {...}, startedAt, solved, steps, time }

local function send(player, action, payload)
	if DailyLadder.Send then
		DailyLadder.Send(player, action, payload)
	end
end

local function session(player)
	local pz = DailyLadder.Today()
	local s = sessions[player]
	if not s or s.day ~= pz.day then
		local prof = PlayerData.Get(player)
		local done = prof and prof.ladderDay == pz.day
		s = {
			day = pz.day,
			chain = { pz.start },
			startedAt = os.clock(),
			solved = done,
			steps = done and prof.ladderSteps or nil,
		}
		sessions[player] = s
	end
	return s, pz
end

local function state(player, extra)
	local s, pz = session(player)
	local prof = PlayerData.Get(player)
	local out = {
		number = pz.number,
		start = pz.start,
		target = pz.target,
		par = pz.par,
		chain = s.chain,
		solved = s.solved,
		steps = s.steps,
		elapsed = math.floor(os.clock() - s.startedAt),
		streak = prof and prof.ladderStreak or 0,
		helps = prof and (prof.inventory.Help or 0) or 0,
	}
	for k, v in pairs(extra or {}) do
		out[k] = v
	end
	return out
end

function DailyLadder.Open(player)
	send(player, "Ladder", state(player))
end

-- returns nil on success, or a reason string
function DailyLadder.Move(player, raw)
	local s, pz = session(player)
	if s.solved and #s.chain == 1 then
		-- already solved today: replaying is allowed for fun, no rewards
		s.replay = true
	end
	local cur = s.chain[#s.chain]
	local w = WordRules.Normalize(raw)
	local reason
	if not w or #w ~= LEN then
		reason = "Type a " .. LEN .. "-letter word."
	elseif w == cur then
		reason = "Change one letter."
	elseif (WordRules.Diff(cur, w)) ~= 1 then
		reason = "Change exactly ONE letter."
	elseif table.find(s.chain, w) then
		reason = string.upper(w) .. " is already in your ladder."
	elseif not Dictionary.IsWord(w) then
		reason = string.upper(w) .. " is not in the dictionary."
	elseif not Dictionary.IsAllowed(w, player.UserId) then
		reason = "That word is not allowed."
	end
	if reason then
		send(player, "Ladder", state(player, { invalid = reason }))
		return reason
	end
	table.insert(s.chain, w)
	if w == pz.target then
		local steps = #s.chain - 1
		local secs = math.floor(os.clock() - s.startedAt)
		local reward
		local prof = PlayerData.Get(player)
		if prof and prof.ladderDay ~= pz.day and not s.replay then
			prof.ladderStreak = (prof.ladderDay == pz.day - 1) and (prof.ladderStreak + 1) or 1
			prof.ladderDay = pz.day
			prof.ladderSteps = steps
			prof.ladderSolves += 1
			local coins = Config.LadderReward.coins + (steps <= pz.par and Config.LadderReward.parBonus or 0) + Config.LadderReward.perStreak * math.min(prof.ladderStreak, 10)
			prof.coins += coins
			PlayerData.AddXP(player, Config.LadderReward.xp)
			PlayerData.CheckAchievements(player)
			PlayerData.Changed(player)
			reward = { coins = coins, xp = Config.LadderReward.xp }
		end
		s.solved = true
		s.steps = steps
		send(player, "Ladder", state(player, { justSolved = true, time = secs, reward = reward }))
		return nil
	end
	send(player, "Ladder", state(player))
	return nil
end

function DailyLadder.Undo(player)
	local s = session(player)
	if #s.chain > 1 and not (s.solved and s.chain[#s.chain] == DailyLadder.Today().target) then
		table.remove(s.chain)
	end
	send(player, "Ladder", state(player))
end

function DailyLadder.Restart(player)
	local s, pz = session(player)
	s.chain = { pz.start }
	s.startedAt = os.clock()
	if s.solved then
		s.replay = true
	end
	send(player, "Ladder", state(player))
end

-- spend one Help: reveal the next word on a shortest path from where you are
function DailyLadder.Hint(player)
	local s, pz = session(player)
	local prof = PlayerData.Get(player)
	local cur = s.chain[#s.chain]
	if cur == pz.target then
		return "solved"
	end
	if not prof or (prof.inventory.Help or 0) < 1 then
		send(player, "Ladder", state(player, { invalid = "You need a Hint power-up (Shop)." }))
		return "no help"
	end
	local d = pz.toTarget[cur]
	local best
	if d then
		for _, n in ipairs(Dictionary.Moves(cur, 1, nil, nil)) do
			-- a neighbour one step closer = on a shortest path; prefer everyday words
			if pz.toTarget[n] == d - 1 and not table.find(s.chain, n) and Dictionary.IsAllowed(n) then
				if not best or (Dictionary.IsCommon(n) and not Dictionary.IsCommon(best)) then
					best = n
				end
			end
		end
	end
	if not best then
		send(player, "Ladder", state(player, { invalid = "You've wandered off - press UNDO a few times and try again." }))
		return "no path"
	end
	prof.inventory.Help -= 1
	PlayerData.Changed(player)
	send(player, "Ladder", state(player, { hint = best }))
	return best
end

function DailyLadder.PlayerLeft(player)
	sessions[player] = nil
end

return DailyLadder
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">Dictionary</string><ProtectedString name="Source"><![CDATA[-- Dictionary: loads word lists from ServerStorage.Words (generated by build.py),
-- validates words, searches for legal moves, and filters words through TextService.
local ServerStorage = game:GetService("ServerStorage")
local TextService = game:GetService("TextService")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local WordRules = require(Shared.WordRules)

local Dictionary = {}

local sets = {} -- [length] = { [word] = true }
local lists = {} -- [length] = { word, ... }
local ALPHABET = "abcdefghijklmnopqrstuvwxyz"

for _, mod in ipairs(ServerStorage:WaitForChild("Words"):GetChildren()) do
	if mod:IsA("ModuleScript") then
		local blob = require(mod)
		for w in string.gmatch(blob, "%a+") do
			local len = #w
			sets[len] = sets[len] or {}
			lists[len] = lists[len] or {}
			if not sets[len][w] then
				sets[len][w] = true
				table.insert(lists[len], w)
			end
		end
	end
end

function Dictionary.IsWord(word)
	local s = sets[#word]
	return s ~= nil and s[word] == true
end

-- banned = { [index] = letter } : letters a player may not put back this turn
local function violatesBan(word, banned)
	if not banned then
		return false
	end
	for idx, ch in pairs(banned) do
		if word:sub(idx, idx) == ch then
			return true
		end
	end
	return false
end
Dictionary.ViolatesBan = violatesBan

-- Finds words exactly `diffs` letters away from `word` that are unused and not banned.
-- Stops after `limit` results (nil = all). Returns list.
function Dictionary.Moves(word, diffs, used, banned, limit)
	local out = {}
	local len = #word
	local set = sets[len]
	if not set then
		return out
	end
	limit = limit or math.huge

	local chars = {}
	for i = 1, len do
		chars[i] = word:sub(i, i)
	end

	local function consider()
		local cand = table.concat(chars)
		if set[cand] and not (used and used[cand]) and not violatesBan(cand, banned) then
			table.insert(out, cand)
		end
		return #out >= limit
	end

	-- recursive choose `diffs` positions, each set to a different letter
	local function rec(startIdx, remaining)
		if remaining == 0 then
			return consider()
		end
		for i = startIdx, len - remaining + 1 do
			local orig = chars[i]
			for k = 1, 26 do
				local ch = ALPHABET:sub(k, k)
				if ch ~= orig then
					chars[i] = ch
					if rec(i + 1, remaining - 1) then
						chars[i] = orig
						return true
					end
				end
			end
			chars[i] = orig
		end
		return false
	end

	rec(1, diffs)
	return out
end

function Dictionary.HasMove(word, diffs, used, banned)
	return #Dictionary.Moves(word, diffs, used, banned, 1) > 0
end

-- Smallest number of changed letters (1..3) that still has a legal move, or nil.
function Dictionary.MinEscape(word, used, banned)
	for d = 1, math.min(3, #word) do
		if Dictionary.HasMove(word, d, used, banned) then
			return d
		end
	end
	return nil
end

function Dictionary.IsRare(word)
	return WordRules.IsRare(word, Config.RareLetters)
end

---------------------------------------------------------------- chat-safety filter
-- Every word shown to other players goes through Roblox text filtering once, then is cached.
local filterCache = {}
function Dictionary.IsAllowed(word, userId)
	local cached = filterCache[word]
	if cached ~= nil then
		return cached
	end
	if RunService:IsStudio() then
		return true -- filtering is a no-op in Studio
	end
	local ok, result = pcall(function()
		local res = TextService:FilterStringAsync(word, userId or 1)
		return res:GetNonChatStringForBroadcastAsync()
	end)
	if not ok then
		return true -- filter outage: do not block play; result not cached so it retries later
	end
	local allowed = (string.lower(result) == word)
	filterCache[word] = allowed
	return allowed
end

-- Common everyday start words (generated from words_start.txt), keyed by length.
local startLists = {}
local commonSet = {} -- [word] = true for everyday words
do
	local mod = ServerStorage:FindFirstChild("StartWords")
	if mod and mod:IsA("ModuleScript") then
		for len, blob in pairs(require(mod)) do
			local l = {}
			sets[len] = sets[len] or {}
			lists[len] = lists[len] or {}
			for w in string.gmatch(blob, "%a+") do
				-- start words are always playable, even if the big list lacks them
				if not sets[len][w] then
					sets[len][w] = true
					table.insert(lists[len], w)
				end
				table.insert(l, w)
				commonSet[w] = true
			end
			startLists[len] = l
		end
	end
	-- everyday words (start words + popular.txt): bot moves and Help hints prefer these
	local commonMod = ServerStorage:FindFirstChild("CommonWords")
	if commonMod and commonMod:IsA("ModuleScript") then
		for len, blob in pairs(require(commonMod)) do
			for w in string.gmatch(blob, "%a+") do
				if sets[len] and sets[len][w] then
					commonSet[w] = true
				end
			end
		end
	end
end

-- Random start word: a common word with at least 3 one-letter moves and no rare letters.
-- Falls back to the full dictionary only if the common list has nothing usable.
function Dictionary.StartWord(len)
	local common = startLists[len]
	if common and #common > 0 then
		for _ = 1, 100 do
			local w = common[math.random(1, #common)]
			if not Dictionary.IsRare(w) and #Dictionary.Moves(w, 1, nil, nil, 3) >= 3 and Dictionary.IsAllowed(w) then
				return w
			end
		end
	end
	local list = lists[len] or lists[4]
	for _ = 1, 300 do
		local w = list[math.random(1, #list)]
		if not Dictionary.IsRare(w) and #Dictionary.Moves(w, 1, nil, nil, 3) >= 3 and Dictionary.IsAllowed(w) then
			return w
		end
	end
	return list[1]
end

-- the hand-picked everyday words of a given length (start words, daily ladder ends)
function Dictionary.StartList(len)
	return startLists[len] or {}
end

function Dictionary.IsCommon(word)
	return commonSet[word] == true
end

-- One legal move for the bot or a Help hint. Prefers everyday words so players
-- are not shown obscure Scrabble words; falls back to any allowed word.
function Dictionary.PickMove(word, diffs, used, banned)
	local moves = Dictionary.Moves(word, diffs, used, banned, diffs == 1 and nil or 200)
	local common, other = {}, {}
	for _, w in ipairs(moves) do
		table.insert(commonSet[w] and common or other, w)
	end
	for _, pool in ipairs({ common, other }) do
		while #pool > 0 do
			local i = math.random(#pool)
			if Dictionary.IsAllowed(pool[i]) then
				return pool[i]
			end
			table.remove(pool, i)
		end
	end
	return nil
end

function Dictionary.AllWords(len)
	return lists[len] or {}
end

function Dictionary.Count()
	local n = 0
	for _, l in pairs(lists) do
		n += #l
	end
	return n
end

return Dictionary
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">Leaderboards</string><ProtectedString name="Source"><![CDATA[-- Leaderboards: global Elo and Longest Streak via OrderedDataStore, cached top 10.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local Leaderboards = {}

local boards = {}
do
	local ok = pcall(function()
		boards.elo = DataStoreService:GetOrderedDataStore("WordDuel_Elo_v1")
		boards.streak = DataStoreService:GetOrderedDataStore("WordDuel_Streak_v1")
		boards.longest = DataStoreService:GetOrderedDataStore("WordDuel_LongestWord_v1")
		boards.longrun = DataStoreService:GetOrderedDataStore("WordDuel_LongRun_v1")
		boards.longwords = DataStoreService:GetOrderedDataStore("WordDuel_LongWords_v1")
		boards.score = DataStoreService:GetOrderedDataStore("WordDuel_BestScore_v1")
	end)
	if not ok then
		boards = {}
	end
end

local cache = { elo = {}, streak = {}, longest = {}, longrun = {}, longwords = {}, score = {} }
-- which profile field feeds each board
local FIELD = { elo = "elo", streak = "bestStreak", longest = "bestWordLen", longrun = "longStreakBest", longwords = "longWords", score = "bestScore" }
local nameCache = {}
local lastSubmit = {} -- [userId] = os.clock()

local function nameOf(userId)
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	nameCache[userId] = ok and name or ("User " .. userId)
	return nameCache[userId]
end

function Leaderboards.Submit(player, profile, force)
	if not boards.elo then
		return
	end
	local uid = player.UserId
	if uid <= 0 then
		return -- Studio test players
	end
	-- throttle writes per player (forced on leave so the final value lands)
	if not force and lastSubmit[uid] and os.clock() - lastSubmit[uid] < 20 then
		return
	end
	lastSubmit[uid] = os.clock()
	task.spawn(function()
		pcall(function()
			for key, store in pairs(boards) do
				store:SetAsync(tostring(uid), math.floor(profile[FIELD[key]] or 0))
			end
		end)
	end)
end

local function refresh()
	for key, store in pairs(boards) do
		local ok, pages = pcall(function()
			return store:GetSortedAsync(false, 10)
		end)
		if ok then
			local list = {}
			for rank, entry in ipairs(pages:GetCurrentPage()) do
				local uid = tonumber(entry.key)
				table.insert(list, { rank = rank, name = uid and nameOf(uid) or entry.key, value = entry.value })
			end
			cache[key] = list
		end
	end
end

function Leaderboards.Get()
	return cache
end

task.spawn(function()
	while true do
		pcall(refresh)
		task.wait(60)
	end
end)

return Leaderboards
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Lobby</string><ProtectedString name="Source"><![CDATA[-- Lobby: ranked queue (level brackets), bots, King of the Table, private friend tables,
-- and match results (Elo, XP, coins, streaks, leaderboards).
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local PlayerData = require(script.Parent.PlayerData)
local Arena = require(script.Parent.Arena)
local Match = require(script.Parent.Match)
local Leaderboards = require(script.Parent.Leaderboards)
local Ambient = require(script.Parent.Ambient)

local Lobby = {}
Lobby.Send = nil -- function(player, action, payload)

local queue = {} -- { {player=, since=, offered=bool} }
local kings = {} -- { {player=, table=, word=, since=} }
local privates = {} -- [code] = { host = player, since = }
local pendingChoice = {} -- [player] = { table=, word=, token= }

local function send(player, action, payload)
	if Lobby.Send and player and player.Parent then
		Lobby.Send(player, action, payload)
	end
end

local function removeFrom(list, player)
	for i = #list, 1, -1 do
		if list[i].player == player then
			if list[i].reservedTable then
				Arena.ClearSeats(list[i].reservedTable)
				releaseTable(list[i].reservedTable)
			end
			table.remove(list, i)
		end
	end
end

local function inQueue(player)
	for _, q in ipairs(queue) do
		if q.player == player then
			return true
		end
	end
	return false
end

local function levelOf(player)
	local p = PlayerData.Get(player)
	return p and p.level or 1
end

local function bracket(waitSeconds)
	return Config.BaseBracket + math.floor(waitSeconds / Config.BracketWidenEvery) * Config.BracketWiden
end

local function isKing(player)
	for _, k in ipairs(kings) do
		if k.player == player then
			return true
		end
	end
	return false
end

function Lobby.IsBusy(player)
	return Match.ByPlayer[player] ~= nil or pendingChoice[player] ~= nil or inQueue(player) or isKing(player)
end

local function releaseTable(tbl)
	tbl.busy = false
	Arena.ClearSeats(tbl)
	Arena.SetDisplay(tbl, nil, nil)
	Arena.SetClock(tbl, 0)
	Arena.SetTimer(tbl, nil)
	-- hand the table back to an ambient NPC duel after a short pause
	task.delay(4, function()
		if not tbl.busy then
			Ambient.Start(tbl)
		end
	end)
end

local function toLobby(player)
	Arena.Unseat(player)
	send(player, "LobbyReturn", {})
end

---------------------------------------------------------------- results
local function elo(a, b, aWon)
	local expected = 1 / (1 + 10 ^ ((b - a) / 400))
	local score = aWon and 1 or 0
	return math.floor(Config.EloK * (score - expected) + 0.5)
end

local onEnd -- forward declaration

local function startMatch(tbl, a, b, opts)
	Ambient.Stop(tbl)
	opts.onEnd = onEnd
	return Match.new(tbl, a, b, opts)
end

onEnd = function(match, winner, loser, reason)
	local tbl = match.table
	local ranked = match.ranked
	-- practice/tutorial opponents are labelled bots; matchmaking bots count like people
	local vsBot = (winner.kind == "bot" and not winner.disguised) or (loser.kind == "bot" and not loser.disguised)
	local results = {}

	if match.tutorial then
		local learner = winner.player and winner or loser
		local plr = learner.player
		local p = plr and PlayerData.Get(plr)
		local res = { won = winner == learner, reason = reason, word = match.word, words = learner.words, eloDelta = 0, xp = 0, coins = 0, tutorial = true }
		if p and winner == learner and not p.tutorialDone then
			p.tutorialDone = true
			res.coins = Config.TutorialReward.coins or 0
			res.xp = 20
			PlayerData.Grant(plr, Config.TutorialReward, true)
			PlayerData.AddXP(plr, res.xp, true)
			PlayerData.Changed(plr)
		end
		if plr then
			send(plr, "BoutEnd", res)
			task.delay(2.5, function()
				if plr.Parent and not Match.ByPlayer[plr] then
					toLobby(plr)
				end
				releaseTable(tbl)
			end)
		else
			releaseTable(tbl)
		end
		return
	end

	local delta = 0
	if ranked then
		delta = elo(winner.elo, loser.elo, true)
	end

	-- loser
	if loser.player then
		local p = PlayerData.Get(loser.player)
		local res = { won = false, reason = reason, word = match.word, words = loser.words, eloDelta = 0, xp = 0, coins = 0, score = loser.score, rivalScore = winner.score }
		if p then
			if ranked then
				-- Elo Protection: If player timed out but outscored the winner, Elo loss is cut in half!
				local protected = (loser.score or 0) > (winner.score or 0)
				local eloLost = delta
				if protected then
					eloLost = math.floor(delta * 0.5)
					res.eloProtected = true
				end
				p.elo = math.max(0, p.elo - eloLost)
				p.losses += 1
				res.eloDelta = -eloLost
			end
			p.matches += 1
			p.curStreak = 0
			p.totalScore = (p.totalScore or 0) + (res.score or 0)
			if reason ~= "left" then
				res.xp = vsBot and 5 or Config.Reward.LossXP
				res.coins = vsBot and 0 or Config.Reward.LossCoins
				local scoreCoins = math.min(Config.ScoreCoinCap, math.floor((res.score or 0) * Config.ScoreCoinRate))
				res.scoreCoins = scoreCoins
				res.coins += scoreCoins
				p.coins += res.coins
				PlayerData.AddXP(loser.player, res.xp, false)
			end
			PlayerData.CheckAchievements(loser.player)
			PlayerData.Changed(loser.player)
			PlayerData.CheckScoreRecord(loser.player, loser.score)
			Leaderboards.Submit(loser.player, p)
		end
		results[loser.player] = res
	end

	-- winner
	if winner.player then
		local p = PlayerData.Get(winner.player)
		local res = { won = true, reason = reason, word = match.word, words = winner.words, eloDelta = 0, xp = 0, coins = 0, score = winner.score, rivalScore = loser.score }
		if p then
			p.matches += 1
			p.totalScore = (p.totalScore or 0) + (res.score or 0)
			if ranked then
				p.elo += delta
				p.wins += 1
				p.curStreak += 1
				p.bestStreak = math.max(p.bestStreak, p.curStreak)
				res.eloDelta = delta
				res.xp = Config.Reward.WinXP + Config.Reward.WinStreakXP * math.min(p.curStreak - 1, 10)
				res.coins = Config.Reward.WinCoins
				local milestone = Config.StreakMilestones[p.curStreak]
				if milestone then
					PlayerData.Reward(winner.player, "streak", p.curStreak .. " WINS", "King of the Table streak bonus", milestone)
				end
			else
				res.xp = Config.Reward.BotWinXP
				res.coins = Config.Reward.BotWinCoins
			end
			res.streak = p.curStreak
			local scoreCoins = math.min(Config.ScoreCoinCap, math.floor((res.score or 0) * Config.ScoreCoinRate))
			res.scoreCoins = scoreCoins
			res.coins += scoreCoins
			p.coins += res.coins
			PlayerData.AddXP(winner.player, res.xp, true)
			PlayerData.CheckAchievements(winner.player)
			PlayerData.Changed(winner.player)
			PlayerData.CheckScoreRecord(winner.player, winner.score)
			Leaderboards.Submit(winner.player, p)

			-- Subway Surfers-style rare item drop on victory!
			local dropRoll = math.random()
			local dropChance = (winner.score and winner.score >= 25) and 0.35 or 0.20
			if dropRoll < dropChance then
				local dropPool = { "Help", "Time", "Help", "Time", "Skip", "DoubleShift" }
				local droppedItem = dropPool[math.random(#dropPool)]
				local itemName = Config.Items[droppedItem].name
				res.luckyDrop = { item = droppedItem, name = itemName }
				PlayerData.Reward(winner.player, "bonus", "LUCKY DROP!", "+1 " .. itemName .. " found after the match!", { [droppedItem] = 1 })
			end
		end
		res.canKing = ranked and not match.private and reason ~= "left_server"
		results[winner.player] = res
	end

	-- Award for biggest word in that entire match
	if match.biggestWord and match.biggestWordLen >= 6 and match.biggestWordPlayer then
		PlayerData.Reward(match.biggestWordPlayer, "award", "BIGGEST WORD", string.upper(match.biggestWord) .. " (" .. match.biggestWordLen .. " letters • Match Best)", { coins = 150 })
	end

	for plr, res in pairs(results) do
		send(plr, "BoutEnd", res)
	end

	-- loser leaves the table
	if loser.player then
		task.delay(2.5, function()
			if loser.player.Parent and not Match.ByPlayer[loser.player] then
				toLobby(loser.player)
			end
		end)
	end

	-- private, practice, or bot-won: table closes
	if not winner.player or match.private or not ranked then
		task.delay(2.5, function()
			if winner.player and winner.player.Parent then
				toLobby(winner.player)
			end
			releaseTable(tbl)
		end)
		return
	end

	-- winner chooses: Cash Out or King of the Table
	local token = {}
	pendingChoice[winner.player] = { table = tbl, word = match.word, token = token, finalClock = match.turnTime, side = winner.side or 1 }
	-- staying on as King is the default; the winner only acts to Cash Out
	task.delay(Config.ContinueChoiceSeconds, function()
		local pc = pendingChoice[winner.player]
		if pc and pc.token == token then
			Lobby.Choice(winner.player, "king")
		end
	end)
end

---------------------------------------------------------------- public API
function Lobby.Queue(player)
	if Lobby.IsBusy(player) then
		return
	end
	-- hosting a friend table and queueing at once could seat you in two matches
	if Lobby.HostCode(player) then
		Lobby.CancelPrivate(player)
	end
	local tbl = Arena.FreeTable()
	if tbl then
		Ambient.Stop(tbl)
		tbl.busy = true
		Arena.Seat(tbl, 1, player)
		Arena.SetDisplay(tbl, "", string.format("%s (Lv %d)  vs  FINDING OPPONENT...", player.Name, levelOf(player)))
	end
	local fill = Config.BotFillMin + math.random() * (Config.BotFillMax - Config.BotFillMin)
	table.insert(queue, { player = player, since = os.clock(), offered = false, fillAt = os.clock() + fill, reservedTable = tbl })
	send(player, "QueueState", { searching = true, bracket = Config.BaseBracket, seated = tbl ~= nil })
end

function Lobby.CancelQueue(player)
	removeFrom(queue, player)
	toLobby(player)
	send(player, "QueueState", { searching = false })
end

function Lobby.PlayBot(player)
	if Match.ByPlayer[player] or pendingChoice[player] then
		return
	end
	removeFrom(queue, player)
	local tbl = Arena.FreeTable()
	if not tbl then
		return send(player, "Toast", "All tables are busy. Try again in a moment.")
	end
	send(player, "QueueState", { searching = false })
	startMatch(tbl, Match.PlayerEntity(player), Match.BotEntity(levelOf(player)), { ranked = false })
end

local function eloOf(player)
	local p = PlayerData.Get(player)
	return p and p.elo or Config.StartElo
end

-- a human-like bot with a skill close to the player's
-- a human-like bot with a skill close to the player's; `finalClock` (the pace you just won
-- at) makes the next King challenger tougher the faster you were going
local function disguisedFor(player, finalClock)
	local pace = 0
	if finalClock then
		pace = math.max(0, Config.StartClockForLevel(levelOf(player)) - finalClock) * 30
	end
	local p = PlayerData.Get(player)
	return Match.BotEntity(levelOf(player), { disguised = true, elo = math.max(0, eloOf(player) + pace + math.random(-60, 60)), xp = p and p.xp or 0 })
end

-- first-time tutorial: a relaxed match against a coach on an easy word
function Lobby.StartTutorial(player)
	if Lobby.IsBusy(player) then
		return
	end
	removeFrom(queue, player)
	local tbl = Arena.FreeTable()
	if not tbl then
		return send(player, "Toast", "All tables are busy. Try again in a moment.")
	end
	local starts = { "cat", "hot", "pin", "map", "bed", "cup" }
	startMatch(tbl, Match.PlayerEntity(player), Match.BotEntity(1, { tutorial = true }), {
		ranked = false,
		tutorial = true,
		word = starts[math.random(#starts)],
	})
end

function Lobby.SkipTutorial(player)
	local p = PlayerData.Get(player)
	if p and not p.tutorialDone then
		p.tutorialDone = true
		PlayerData.Changed(player)
	end
end

function Lobby.Choice(player, choice)
	local pc = pendingChoice[player]
	if not pc then
		return
	end
	pendingChoice[player] = nil
	if choice == "king" and player.Parent then
		-- a challenger sits down right away: a waiting human in range first, otherwise a bot
		table.insert(kings, { player = player, table = pc.table, word = pc.word, since = os.clock(), fillAt = os.clock(), finalClock = pc.finalClock, side = pc.side or 1 })
		Arena.SetDisplay(pc.table, pc.word, player.DisplayName .. " is King of the Table")
		if Lobby._tick then
			task.spawn(Lobby._tick)
		end
	else
		-- cashing out ends your King run
		local p = PlayerData.Get(player)
		if p then
			p.curStreak = 0
			PlayerData.Changed(player)
		end
		releaseTable(pc.table)
		if player.Parent then
			toLobby(player)
		end
	end
end

function Lobby.LeaveTable(player)
	for i, k in ipairs(kings) do
		if k.player == player then
			table.remove(kings, i)
			local p = PlayerData.Get(player)
			if p then
				p.curStreak = 0
				PlayerData.Changed(player)
			end
			releaseTable(k.table)
			toLobby(player)
			return
		end
	end
	local pc = pendingChoice[player]
	if pc then
		pendingChoice[player] = nil
		local p = PlayerData.Get(player)
		if p then
			p.curStreak = 0
			PlayerData.Changed(player)
		end
		releaseTable(pc.table)
		toLobby(player)
		return
	end
	for _, tbl in ipairs(Arena.Tables) do
		if tbl.assigned[1] == player or tbl.assigned[2] == player then
			releaseTable(tbl)
			break
		end
	end
	toLobby(player)
end

local function orderKingSides(kingSide, kingEnt, challengerEnt)
	if kingSide == 2 then
		return challengerEnt, kingEnt
	end
	return kingEnt, challengerEnt
end

function Lobby.KingBot(player)
	for i, k in ipairs(kings) do
		if k.player == player then
			table.remove(kings, i)
			local a, b = orderKingSides(k.side, Match.PlayerEntity(player), Match.BotEntity(levelOf(player)))
			startMatch(k.table, a, b, {
				word = k.word,
				startClock = Config.KingStartClock(k.finalClock, levelOf(player)),
				firstTurn = (k.side == 2) and 1 or 2,
				ranked = false,
			})
			return
		end
	end
end

function Lobby.KingCashOut(player)
	for i, k in ipairs(kings) do
		if k.player == player then
			table.remove(kings, i)
			local p = PlayerData.Get(player)
			if p then
				p.curStreak = 0
				PlayerData.Changed(player)
			end
			releaseTable(k.table)
			toLobby(player)
			return
		end
	end
end

-- private friend tables -----------------------------------------------------------
local function newCode()
	local chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"
	local s = ""
	for _ = 1, 5 do
		local i = math.random(#chars)
		s ..= chars:sub(i, i)
	end
	return s
end

function Lobby.CreatePrivate(player)
	if Lobby.IsBusy(player) then
		return
	end
	for code, pv in pairs(privates) do
		if pv.host == player then
			return send(player, "PrivateCode", { code = code })
		end
	end
	local code = newCode()
	while privates[code] do
		code = newCode()
	end
	privates[code] = { host = player, since = os.clock() }
	send(player, "PrivateCode", { code = code })
	return code
end

function Lobby.CancelPrivate(player)
	for code, pv in pairs(privates) do
		if pv.host == player then
			privates[code] = nil
		end
	end
	send(player, "PrivateCode", { code = nil })
end

function Lobby.HostCode(player)
	for code, pv in pairs(privates) do
		if pv.host == player then
			return code
		end
	end
	return nil
end

function Lobby.JoinPrivate(player, code)
	if type(code) ~= "string" then
		return
	end
	code = string.upper(code):gsub("%s", "")
	local pv = privates[code]
	if not pv or not pv.host.Parent then
		return send(player, "Toast", "No open table with code " .. code .. " in this server.")
	end
	if pv.host == player then
		return
	end
	if Lobby.IsBusy(player) or Lobby.IsBusy(pv.host) then
		return send(player, "Toast", "That player is busy right now.")
	end
	local tbl = Arena.FreeTable()
	if not tbl then
		return send(player, "Toast", "All tables are busy. Try again in a moment.")
	end
	privates[code] = nil
	send(pv.host, "PrivateCode", { code = nil })
	startMatch(tbl, Match.PlayerEntity(pv.host), Match.PlayerEntity(player), { private = true, ranked = false })
end

---------------------------------------------------------------- leaving
function Lobby.PlayerLeft(player)
	removeFrom(queue, player)
	local m = Match.ByPlayer[player]
	if m then
		m:forfeit(player)
	end
	local pc = pendingChoice[player]
	if pc then
		pendingChoice[player] = nil
		releaseTable(pc.table)
	end
	for i = #kings, 1, -1 do
		if kings[i].player == player then
			releaseTable(kings[i].table)
			table.remove(kings, i)
		end
	end
	Lobby.CancelPrivate(player)
end

---------------------------------------------------------------- matchmaking loop
local function tick()
	local t = os.clock()

	-- 1) Kings get challengers first: newcomer inherits the exact word, clock resets to 10s
	for ki = #kings, 1, -1 do
		local k = kings[ki]
		local kLevel = levelOf(k.player)
		for qi, q in ipairs(queue) do
			local range = bracket(t - q.since)
			if math.abs(levelOf(q.player) - kLevel) <= range then
				if q.reservedTable then
					Arena.ClearSeats(q.reservedTable)
					releaseTable(q.reservedTable)
					q.reservedTable = nil
				end
				table.remove(kings, ki)
				table.remove(queue, qi)
				send(q.player, "QueueState", { searching = false })
				local a, b = orderKingSides(k.side, Match.PlayerEntity(k.player), Match.PlayerEntity(q.player))
				startMatch(k.table, a, b, {
					word = k.word,
					startClock = Config.KingStartClock(k.finalClock, levelOf(k.player)),
					ranked = true,
					kingFor = k.player,
				})
				break
			end
		end
	end

	-- 2) pair queued players within level brackets
	local i = 1
	while i <= #queue do
		local a = queue[i]
		local matched = false
		for j = i + 1, #queue do
			local b = queue[j]
			local range = bracket(t - math.min(a.since, b.since))
			if math.abs(levelOf(a.player) - levelOf(b.player)) <= range then
				local tbl = a.reservedTable or b.reservedTable or Arena.FreeTable()
				if not tbl then
					break
				end
				if a.reservedTable and a.reservedTable ~= tbl then
					releaseTable(a.reservedTable)
				end
				if b.reservedTable and b.reservedTable ~= tbl then
					releaseTable(b.reservedTable)
				end
				a.reservedTable = nil
				b.reservedTable = nil
				table.remove(queue, j)
				table.remove(queue, i)
				send(a.player, "QueueState", { searching = false })
				send(b.player, "QueueState", { searching = false })
				startMatch(tbl, Match.PlayerEntity(a.player), Match.PlayerEntity(b.player), { ranked = true })
				matched = true
				break
			end
		end
		if not matched then
			i += 1
		end
	end

	-- 3) nobody waits long: unmatched players get a human-like bot, kings get a challenger
	for qi = #queue, 1, -1 do
		local q = queue[qi]
		if t >= q.fillAt then
			local tbl = q.reservedTable or Arena.FreeTable()
			if tbl then
				q.reservedTable = nil
				table.remove(queue, qi)
				send(q.player, "QueueState", { searching = false })
				startMatch(tbl, Match.PlayerEntity(q.player), disguisedFor(q.player), { ranked = true })
			end
		end
	end
	for ki = #kings, 1, -1 do
		local k = kings[ki]
		if t >= k.fillAt and k.player.Parent then
			table.remove(kings, ki)
			local a, b = orderKingSides(k.side, Match.PlayerEntity(k.player), disguisedFor(k.player, k.finalClock))
			startMatch(k.table, a, b, {
				word = k.word,
				startClock = Config.KingStartClock(k.finalClock, levelOf(k.player)),
				ranked = true,
				kingFor = k.player,
			})
		end
	end

	-- 4) status for people still waiting
	for _, q in ipairs(queue) do
		local waited = t - q.since
		send(q.player, "QueueState", { searching = true, bracket = bracket(waited), waited = math.floor(waited), seated = q.reservedTable ~= nil })
	end
end

Lobby._tick = tick
Ambient.FillAll()

task.spawn(function()
	while true do
		task.wait(1)
		local ok, err = pcall(tick)
		if not ok then
			warn("[WordDuel] matchmaking error:", err)
		end
	end
end)

return Lobby
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX0000000C"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Word Duel server entry point: remotes, player lifecycle, request routing.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Net = Instance.new("RemoteEvent")
Net.Name = "Net"
Net.Parent = ReplicatedStorage

local Dictionary = require(script.Parent.Dictionary)
local PlayerData = require(script.Parent.PlayerData)
local Arena = require(script.Parent.Arena)
local Match = require(script.Parent.Match)
local Leaderboards = require(script.Parent.Leaderboards)
local Lobby = require(script.Parent.Lobby)
local Shop = require(script.Parent.Shop)
local DailyLadder = require(script.Parent.DailyLadder)

print(("[WordDuel] dictionary loaded: %d words, %d tables"):format(Dictionary.Count(), #Arena.Tables))

local function send(player, action, payload)
	if typeof(player) == "Instance" and player.Parent then
		Net:FireClient(player, action, payload)
	end
end
Match.Send = send
Lobby.Send = send
DailyLadder.Send = send

-- profile snapshot sent to the owning client
local function snapshot(p)
	local rank = Config.RankFor(p.elo)
	return {
		xp = p.xp,
		xpNext = Config.XPToNext(p.level),
		level = p.level,
		elo = p.elo,
		rank = rank.name,
		coins = p.coins,
		shards = p.shards,
		wins = p.wins,
		losses = p.losses,
		curStreak = p.curStreak,
		bestStreak = p.bestStreak,
		wordsPlayed = p.wordsPlayed,
		rareWords = p.rareWords,
		dailyStreak = p.dailyStreak,
		inventory = p.inventory,
		belt = p.belt,
		slots = PlayerData.Slots(p),
		achievements = p.achievements,
		wordLength = Config.LengthForLevel(p.level),
		tutorialDone = p.tutorialDone == true,
		ladderSolves = p.ladderSolves,
		bestWordLen = p.bestWordLen,
		bestWord = p.bestWord,
		longWords = p.longWords,
		longStreakBest = p.longStreakBest,
		bestScore = p.bestScore,
	}
end

PlayerData.OnChanged = function(player, p)
	send(player, "Profile", snapshot(p))
end
PlayerData.OnReward = function(player, payload)
	send(player, "Reward", payload)
end
PlayerData.OnToast = function(player, text)
	send(player, "Toast", text)
end
PlayerData.OnLevelUp = function(player)
	Shop.CheckReferralPayout(player)
end

-- per-player request rate limit
local budget = {}
local function allow(player)
	local b = budget[player]
	local t = os.clock()
	if not b or t - b.t > 1 then
		budget[player] = { t = t, n = 1 }
		return true
	end
	b.n += 1
	return b.n <= 12
end

local handlers = {
	Queue = function(plr)
		Lobby.Queue(plr)
	end,
	CancelQueue = function(plr)
		Lobby.CancelQueue(plr)
	end,
	PlayBot = function(plr)
		Lobby.PlayBot(plr)
	end,
	Submit = function(plr, word)
		local m = Match.ByPlayer[plr]
		if m then
			m:submit(plr, word)
		end
	end,
	UseItem = function(plr, kind)
		local m = Match.ByPlayer[plr]
		if m and type(kind) == "string" then
			m:useItem(plr, kind)
		end
	end,
	Choice = function(plr, choice)
		Lobby.Choice(plr, choice)
	end,
	KingBot = function(plr)
		Lobby.KingBot(plr)
	end,
	KingCashOut = function(plr)
		Lobby.KingCashOut(plr)
	end,
	CreatePrivate = function(plr)
		Lobby.CreatePrivate(plr)
	end,
	CancelPrivate = function(plr)
		Lobby.CancelPrivate(plr)
	end,
	JoinPrivate = function(plr, code)
		Lobby.JoinPrivate(plr, code)
	end,
	SetBelt = function(plr, list)
		if not Lobby.IsBusy(plr) then
			Shop.SetBelt(plr, list)
		else
			send(plr, "Toast", "Change your belt in the lobby, not mid-match.")
		end
	end,
	BuyProduct = function(plr, key)
		Shop.Buy(plr, key)
	end,
	BuyCoins = function(plr, kind)
		Shop.BuyWithCoins(plr, kind)
	end,
	BuySlotCoins = function(plr, slot)
		Shop.BuySlotWithCoins(plr, slot)
	end,
	LadderOpen = function(plr)
		DailyLadder.Open(plr)
	end,
	LadderMove = function(plr, word)
		if type(word) == "string" then
			DailyLadder.Move(plr, word)
		end
	end,
	LadderUndo = function(plr)
		DailyLadder.Undo(plr)
	end,
	LadderRestart = function(plr)
		DailyLadder.Restart(plr)
	end,
	LadderHint = function(plr)
		DailyLadder.Hint(plr)
	end,
	StartTutorial = function(plr)
		Lobby.StartTutorial(plr)
	end,
	SkipTutorial = function(plr)
		Lobby.SkipTutorial(plr)
	end,
	LeaveTable = function(plr)
		Lobby.LeaveTable(plr)
	end,
	GetLeaderboard = function(plr)
		send(plr, "Leaderboard", Leaderboards.Get())
	end,
	GetInviteData = function(plr)
		local code = Lobby.HostCode(plr) or Lobby.CreatePrivate(plr)
		send(plr, "InviteData", { launchData = "ref=" .. plr.UserId .. (code and (";code=" .. code) or "") })
	end,
	ClientReady = function(plr)
		task.spawn(function()
			local p = PlayerData.Get(plr)
			local t0 = os.clock()
			while not p and plr.Parent and (os.clock() - t0 < 5) do
				task.wait(0.05)
				p = PlayerData.Get(plr)
			end
			if not p or not plr.Parent then
				return
			end
			PlayerData.CheckAchievements(plr)
			PlayerData.Daily(plr)
			PlayerData.Changed(plr)
			send(plr, "Leaderboard", Leaderboards.Get())
		end)
	end,
	ResetFirstTime = function(plr)
		local p = PlayerData.Get(plr)
		if p then
			p.matches = 0
			p.tutorialDone = false
			p.dailyDay = 0
			p.dailyStreak = 0
			p.coins = 0
			p.xp = 0
			p.level = 1
			p.elo = Config.StartElo
			PlayerData.Save(plr)
			PlayerData.Daily(plr)
			PlayerData.Changed(plr)
			send(plr, "Toast", "Reset to First-Time Player!")
		end
	end,
}

Net.OnServerEvent:Connect(function(player, action, payload)
	if type(action) ~= "string" or not allow(player) then
		return
	end
	local h = handlers[action]
	if h and (action == "ClientReady" or PlayerData.Get(player)) then
		local ok, err = pcall(h, player, payload)
		if not ok then
			warn("[WordDuel] handler", action, "failed:", err)
		end
	end
end)

local function onPlayerAdded(player)
	local profile = PlayerData.Load(player)
	if not profile then
		return
	end
	local ref, code = Shop.ParseLaunchData(player)
	Shop.RegisterReferral(player, ref)
	Shop.ClaimPendingReferrals(player)
	PlayerData.Changed(player)
	send(player, "Leaderboard", Leaderboards.Get())
	-- joined through a friend's invite: sit at their private table automatically
	if code then
		task.delay(4, function()
			if player.Parent then
				Lobby.JoinPrivate(player, code)
			end
		end)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, plr in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, plr)
end

Players.PlayerRemoving:Connect(function(player)
	Lobby.PlayerLeft(player)
	DailyLadder.PlayerLeft(player)
	local p = PlayerData.Get(player)
	if p then
		Leaderboards.Submit(player, p, true)
	end
	PlayerData.Release(player)
	budget[player] = nil
end)

-- Studio-only automated test hooks (no-op in a live game)
require(script.Parent.TestHooks).Start({
	Match = Match,
	Lobby = Lobby,
	Dictionary = Dictionary,
	PlayerData = PlayerData,
	Shop = Shop,
	Config = Config,
	Arena = Arena,
	Ambient = require(script.Parent.Ambient),
	DailyLadder = DailyLadder,
})

-- server shutdown: save everyone before the server closes
game:BindToClose(function()
	local pending = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		pending += 1
		task.spawn(function()
			PlayerData.Save(plr)
			pending -= 1
		end)
	end
	local start = os.clock()
	while pending > 0 and os.clock() - start < 25 do
		task.wait(0.2)
	end
end)

-- periodically claim referral payouts for friends who levelled up while the inviter was offline
task.spawn(function()
	while true do
		task.wait(90)
		for _, plr in ipairs(Players:GetPlayers()) do
			task.spawn(Shop.ClaimPendingReferrals, plr)
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">Match</string><ProtectedString name="Source"><![CDATA[-- Match: one 1v1 bout at a table. Infinite rally on a clock that keeps speeding up.
-- Rules:
--   * play any real word (3-10 letters) that keeps AT LEAST ONE letter in the same spot as
--     the previous word; no plural/past tense of the previous word; no repeats in a match
--   * points = letters kept in place + letters added (CAT -> CATER = 5, TREAD -> STEAL = 2)
--   * clock: starts by level (or King momentum), speeds up every move with easing, never below the floor
--   * run out of time and you lose; points are your score (bonus coins/XP), survival decides the win
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local WordRules = require(Shared.WordRules)

local Dictionary = require(script.Parent.Dictionary)
local PlayerData = require(script.Parent.PlayerData)
local Arena = require(script.Parent.Arena)
local NPC = require(script.Parent.NPC)

local Match = {}
Match.__index = Match
Match.ByPlayer = {} -- [player] = match
Match.Send = nil -- function(player, action, payload), set by Main

local function now()
	return workspace:GetServerTimeNow()
end

local function send(e, action, payload)
	if e.player and Match.Send then
		Match.Send(e.player, action, payload)
	end
end

local MIN_LEN, MAX_LEN = 3, 10

-- letters kept in the same position (a move needs at least one)
local function kept(prev, w)
	return (WordRules.Points(prev, w))
end
Match.kept = kept

local function points(prev, w)
	local _, pts = WordRules.Points(prev, w)
	return pts
end

-- entity helpers ------------------------------------------------------------
function Match.PlayerEntity(player)
	local p = PlayerData.Get(player)
	-- belt slots: the first `base` are open from the start; the next ones are fast-game
	-- slots that open when the clock gets short. Each slot pulls from what you own.
	local slots = {}
	if p then
		local base = PlayerData.Slots(p)
		local maxAllowed = math.min(Config.AbsoluteMaxSlots or 9, base + #Config.FastSlotClocks)
		for i = 1, maxAllowed do
			local kind = p.belt[i]
			local fastAt = i > base and Config.FastSlotClocks[i - base] or nil
			if kind and Config.Items[kind] then
				table.insert(slots, { kind = kind, state = fastAt and "locked" or "empty", fastAt = fastAt, readyIn = 0, slot = i })
			else
				table.insert(slots, { kind = "Empty", state = fastAt and "locked" or "unassigned", fastAt = fastAt, readyIn = 0, slot = i })
			end
		end
	end
	return {
		kind = "player",
		player = player,
		userId = player.UserId,
		name = player.DisplayName,
		level = p and p.level or 1,
		xp = p and p.xp or 0,
		elo = p and p.elo or Config.StartElo,
		slots = slots,
	}
end

local PRACTICE_NAMES = { "Practice Rook", "Practice Bishop", "Practice Knight", "Practice Pawn", "Practice Queen" }

-- opts.disguised: a matchmaking bot that plays like a person (generated name, skill near `elo`)
-- opts.tutorial: the friendly coach used in the first-time tutorial
function Match.BotEntity(level, opts)
	opts = opts or {}
	level = math.max(1, level + math.random(-2, 2))
	local name
	if opts.tutorial then
		name = "Coach Tilly"
	elseif opts.disguised then
		name = NPC.RandomName()
	else
		name = PRACTICE_NAMES[math.random(#PRACTICE_NAMES)]
	end
	local elo = opts.elo or Config.StartElo
	return {
		kind = "bot",
		disguised = opts.disguised == true,
		tutorial = opts.tutorial == true,
		userId = 0,
		name = name,
		level = level,
		xp = opts.xp or 0,
		elo = elo,
		slots = {},
		-- 0..1: how strong this bot plays (stronger = faster, higher scores, slips less)
		skill = math.clamp((elo - 800) / 1000 + (math.random() - 0.5) * 0.2, 0.05, 0.95),
	}
end

local function resetEntity(e, side)
	e.side = side
	e.helpUsed = 0
	e.lastHelpTurn = -99
	e.ownTurns = 0
	e.words = 0
	e.score = 0
	e.doublePoints = false
	e.longRun = 0
end

local function publicInfo(e)
	local rank = Config.RankFor(e.elo)
	-- matchmaking bots look exactly like players; only practice/tutorial opponents are labelled
	return { name = e.name, level = e.level, elo = e.elo, rank = rank.name, userId = e.userId, isBot = e.kind == "bot" and not e.disguised, rig = e.rig }
end

-- power-up slots ------------------------------------------------------------------
-- you can fill a slot only while you own more of that power-up than are already loaded
function Match:canFill(e, kind)
	if self.tutorial then
		return true
	end
	if not kind or kind == "Empty" then
		return false
	end
	local p = e.player and PlayerData.Get(e.player)
	if not p then
		return false
	end
	local loaded = 0
	for _, s in ipairs(e.slots) do
		if s.kind == kind and s.state == "ready" then
			loaded += 1
		end
	end
	return loaded < (p.inventory[kind] or 0)
end

-- fast slots open when the clock gets short; used slots count down and refill; empty
-- slots fill as soon as you own one (e.g. bought mid-game)
function Match:refreshSlots(e, ownTurn)
	local timeLeft = self.deadline and math.max(0, self.deadline - now()) or self.turnTime or 0
	for _, s in ipairs(e.slots or {}) do
		if s.kind and s.kind ~= "Empty" then
			if s.state == "locked" and s.fastAt and (timeLeft <= s.fastAt or (self.turnTime and self.turnTime <= s.fastAt)) then
				s.state = "empty"
				send(e, "SlotOpened", { kind = s.kind, clock = s.fastAt })
			end
			if s.state == "cooldown" and ownTurn then
				s.readyIn -= 1
				if s.readyIn <= 0 then
					s.state = "empty"
				end
			end
			if s.state == "empty" and self:canFill(e, s.kind) then
				s.state = "ready"
			end
		end
	end
end

-- moves ------------------------------------------------------------------------
-- every legal move: unused, keeps a letter in place, not a plural/past tense of the
-- current word. Lengths near the current word (people rarely jump far). { {w=, pts=}, ... }
function Match:candidates()
	local out = {}
	local prev = self.word
	for len = math.max(MIN_LEN, #prev - 2), math.min(MAX_LEN, #prev + 2) do
		for _, w in ipairs(Dictionary.AllWords(len)) do
			if not self.used[w] and kept(prev, w) >= 1 and not WordRules.IsInflection(prev, w) and not WordRules.IsSuffixManipulation(prev, w) and not self:hitsLock(w) then
				table.insert(out, { w = w, pts = points(prev, w) })
			end
		end
	end
	return out
end

-- letter locks ---------------------------------------------------------------------
-- At high levels, once a rally is already fast, a lock sometimes appears: for a few turns
-- in a row, 1-2 letters (taken from the current word) can't be used, different ones each
-- turn. Then it goes away for a while. Always leaves enough legal words to play.
function Match:hitsLock(w, letters)
	if type(letters) ~= "table" then
		letters = self.lockLetters
	end
	if not letters then
		return false
	end
	for _, ch in ipairs(letters) do
		if string.find(w, ch, 1, true) then
			return true
		end
	end
	return false
end

function Match:locksAllowed()
	if self.tutorial or self.volley < Config.LetterLockVolley then
		return false
	end
	local a, b = self.ents[1], self.ents[2]
	return (a.level + b.level) / 2 >= Config.LetterLockLevel
end

function Match:pickLockLetters()
	local letters, seen = {}, {}
	for i = 1, #self.word do
		local ch = self.word:sub(i, i)
		if not seen[ch] then
			seen[ch] = true
			table.insert(letters, ch)
		end
	end
	for i = #letters, 2, -1 do
		local j = math.random(i)
		letters[i], letters[j] = letters[j], letters[i]
	end
	local want = math.random(1, 2)
	for n = want, 1, -1 do
		local pick = { table.unpack(letters, 1, n) }
		self.lockLetters = pick
		local enough = #self:candidates() >= Config.LetterLockMinMoves
		self.lockLetters = nil
		if enough then
			return pick
		end
	end
	return nil
end

function Match:updateLocks()
	self.lockLetters = nil
	if not self:locksAllowed() then
		return
	end
	if (self.lockRun or 0) > 0 then
		self.lockRun -= 1
	elseif (self.lockCooldown or 0) > 0 then
		self.lockCooldown -= 1
		return
	elseif math.random() < Config.LetterLockChance then
		self.lockRun = math.random(Config.LetterLockRun[1], Config.LetterLockRun[2]) - 1
	else
		return
	end
	if self.lockRun == 0 then
		self.lockCooldown = math.random(Config.LetterLockCooldown[1], Config.LetterLockCooldown[2])
	end
	self.lockLetters = self:pickLockLetters()
end

-- a strong everyday move: as many letters kept as possible (used by Help and the tutorial)
function Match:bestMove()
	local best, bestScore
	for _, c in ipairs(self:candidates()) do
		-- everyday words first (a hint nobody knows is useless), then points, then a little
		-- preference for staying near the current length
		local s = (Dictionary.IsCommon(c.w) and 100 or 0) + c.pts * 10 - math.abs(#c.w - #self.word) * 6 + math.random()
		if (not bestScore or s > bestScore) and Dictionary.IsAllowed(c.w) then
			best, bestScore = c, s
		end
	end
	return best and best.w, best and best.pts
end

-- construction --------------------------------------------------------------
-- opts: word, volley, ranked, private, tutorial, firstTurn, onEnd(match, winner, loser, reason)
function Match.new(tbl, a, b, opts)
	local self = setmetatable({}, Match)
	self.table = tbl
	tbl.busy = true
	self.ents = { a, b }
	local function real(e)
		return e.kind == "player" or e.disguised
	end
	self.ranked = opts.ranked and real(a) and real(b)
	self.tutorial = opts.tutorial
	self.private = opts.private
	self.onEnd = opts.onEnd
	self.volley = opts.volley or 0
	-- starting clock: from the players' level, or (King) from the pace the last match was won at
	self.startClock = opts.startClock or Config.StartClockForLevel(math.floor((a.level + b.level) / 2))

	-- Determine turn order:
	-- When playing online (ranked, online, or no explicit firstTurn forced),
	-- the player on the lower level always starts first.
	-- If both are on the exact same level and xp, then have it at random.
	local firstTurn = opts.firstTurn
	if opts.tutorial then
		firstTurn = 1
	elseif not firstTurn or self.ranked or opts.online then
		local aLvl = a.level or 1
		local bLvl = b.level or 1
		local aXp = a.xp or 0
		local bXp = b.xp or 0
		if aLvl < bLvl then
			firstTurn = 1
		elseif bLvl < aLvl then
			firstTurn = 2
		elseif aXp < bXp then
			firstTurn = 1
		elseif bXp < aXp then
			firstTurn = 2
		else
			firstTurn = (math.random(1, 2) == 1) and 1 or 2
		end
	end
	self.turn = firstTurn or 1
	self.firstBigWordDone = false
	self.biggestWord = nil
	self.biggestWordLen = 0
	self.biggestWordPlayer = nil
	self.biggestWordPlayerName = nil
	self.token = 0
	self.active = true

	local len = #(opts.word or "")
	if len == 0 then
		len = Config.LengthForLevel(math.floor((a.level + b.level) / 2))
	end
	self.word = opts.word or Dictionary.StartWord(len)
	self.used = { [self.word] = true }
	self.history = { self.word }
	if self.tutorial then
		for _, e in ipairs(self.ents) do
			if e.kind == "player" then
				e.slots = {}
				for _, kind in ipairs({ "Help", "DoubleShift", "Time", "Skip" }) do
					table.insert(e.slots, { kind = kind, state = "ready", readyIn = 0 })
				end
			end
		end
	end

	Arena.ClearSeats(tbl, { [1] = a.player, [2] = b.player })
	for i, e in ipairs(self.ents) do
		resetEntity(e, i)
		if e.player then
			Match.ByPlayer[e.player] = self
			Arena.Seat(tbl, i, e.player)
			e.rig = e.player.Character
		elseif e.kind == "bot" then
			e.rig = NPC.Build(e.name)
			if e.rig then
				Arena.SeatRig(tbl, i, e.rig)
			end
		end
	end
	Arena.SetDisplay(tbl, self.word, string.format("%s (Lv %d)  vs  %s (Lv %d)", a.name, a.level, b.name, b.level))

	for _, e in ipairs(self.ents) do
		local opp = self.ents[3 - e.side]
		local isKing = opts.kingFor ~= nil and e.player == opts.kingFor
		local kp = isKing and PlayerData.Get(e.player)
		send(e, "MatchStart", { me = publicInfo(e), opp = publicInfo(opp), ranked = self.ranked, private = self.private, tutorial = self.tutorial, king = isKing, kingStreak = kp and kp.curStreak or nil, challenger = opts.kingFor ~= nil and not isKing })
	end
	task.delay(1.5, function()
		self:startTurn()
	end)
	return self
end

function Match:other(e)
	return self.ents[3 - e.side]
end

function Match:broadcast(action, payload)
	for _, e in ipairs(self.ents) do
		send(e, action, payload)
	end
end

function Match:stateFor(e)
	local hist = {}
	for i = math.max(1, #self.history - 11), #self.history do
		table.insert(hist, self.history[i])
	end
	local used = {}
	for w in pairs(self.used) do
		table.insert(used, w)
	end
	local helpCooldown = (e.lastHelpTurn + Config.HelpCooldownTurns) - (e.ownTurns + (self.ents[self.turn] == e and 0 or 1))
	local other = self:other(e)
	return {
		word = self.word,
		prev = self.history[#self.history - 1],
		myTurn = self.ents[self.turn] == e,
		deadline = self.deadline,
		turnTime = self.turnTime,
		history = hist,
		used = used,
		volley = self.volley,
		slots = e.slots,
		helpLeft = Config.HelpMaxPerMatch - e.helpUsed,
		helpCooldown = math.max(0, helpCooldown),
		myScore = e.score,
		rivalScore = other.score,
		doublePoints = e.doublePoints,
		tutorial = self.tutorial,
		myWords = e.words,
		lockLetters = self.lockLetters,
	}
end

function Match:pushState()
	for _, e in ipairs(self.ents) do
		send(e, "MatchState", self:stateFor(e))
	end
end

-- turn flow -----------------------------------------------------------------
function Match:armTimer(token)
	local remaining = self.deadline - now()
	task.delay(math.max(0, remaining), function()
		if not self.active or self.token ~= token then
			return
		end
		if now() < self.deadline - 0.05 then
			self:armTimer(token) -- clock was extended (More Time)
			return
		end
		self:finish(3 - self.turn, "timeout")
	end)
end

function Match:armClutchTimers(token)
	local e = self.ents[self.turn]
	if not e or not self.deadline then
		return
	end
	for _, s in ipairs(e.slots or {}) do
		if s.kind and s.kind ~= "Empty" and s.state == "locked" and s.fastAt then
			local delaySec = (self.deadline - s.fastAt) - now()
			if delaySec > 0 then
				task.delay(delaySec, function()
					if not self.active or self.token ~= token then
						return
					end
					if s.state == "locked" and self.ents[self.turn] == e then
						s.state = "empty"
						if self:canFill(e, s.kind) then
							s.state = "ready"
						end
						send(e, "SlotOpened", { kind = s.kind, clock = s.fastAt })
						self:pushState()
					end
				end)
			else
				s.state = "empty"
				if self:canFill(e, s.kind) then
					s.state = "ready"
				end
				send(e, "SlotOpened", { kind = s.kind, clock = s.fastAt })
			end
		end
	end
end

function Match:startTurn()
	if not self.active then
		return
	end
	self.token += 1
	local token = self.token
	local e = self.ents[self.turn]
	e.ownTurns += 1

	self:updateLocks()
	-- practically never happens: nothing at all keeps a letter in place -> deal a fresh word
	if #self:candidates() == 0 then
		self.lockLetters = nil
		local fresh
		for _ = 1, 20 do
			fresh = Dictionary.StartWord(#self.word)
			if not self.used[fresh] then
				break
			end
		end
		self.word = fresh
		self.used[fresh] = true
		table.insert(self.history, fresh)
		self:broadcast("Toast", "No words left - fresh word: " .. string.upper(fresh))
	end

	self.turnTime = self.tutorial and Config.TutorialTurnTime or Config.TurnTime(self.volley, self.startClock)
	if e.timeShield and e.timeShield > 0 then
		local bonus = e.timeShield
		e.timeShield = 0
		self.turnTime += bonus
		self:broadcast("TimeShieldActive", { by = e.name, added = bonus })
	end
	for _, ent in ipairs(self.ents) do
		self:refreshSlots(ent, ent == e)
	end
	self.deadline = now() + self.turnTime
	Arena.SetClock(self.table, self.turn)
	Arena.SetTimer(self.table, self.deadline)
	Arena.SetDisplay(self.table, self.word, self.table.namesLabel.Text)
	self:pushState()

	self:armTimer(token)
	self:armClutchTimers(token)
	if e.kind == "bot" then
		self:botThink(token)
	elseif self.tutorial and e.words ~= 1 then
		-- tutorial: suggest a good word every turn (except when teaching the Hint power-up)
		local w, pts = self:bestMove()
		if w then
			send(e, "Hint", { word = w, points = pts, coach = true })
		end
	end
end

function Match:reject(e, reason)
	send(e, "Invalid", reason)
end

function Match:applyMove(e, w)
	local old = self.word
	local pts = points(old, w)
	if e.doublePoints then
		pts *= 2
		e.doublePoints = false
	end
	self.word = w
	self.used[w] = true
	table.insert(self.history, w)
	self.volley += 1
	e.words += 1
	e.score += pts

	-- Score Time Shield: scoring a 5+ pt word banks +2.0s buffer for your next turn
	if pts >= 5 then
		e.timeShield = math.min(4.0, (e.timeShield or 0) + 2.0)
		self:broadcast("TimeShieldEarned", { by = e.name, added = 2.0, pts = pts, total = e.timeShield })
	end

	local remaining = self.deadline and math.max(0, self.deadline - now()) or 0
	local clockFrac = (self.turnTime and self.turnTime > 0) and (remaining / self.turnTime) or 0
	local isFast = clockFrac >= 0.5

	local rare = Dictionary.IsRare(w)
	local biblical = Config.IsBiblical(w)
	if e.player then
		local p = PlayerData.Get(e.player)
		if p then
			p.wordsPlayed += 1
			p.coins += Config.Reward.WordCoins + (biblical and 15 or 0)
			if isFast then
				p.fastPlays = (p.fastPlays or 0) + 1
			end
			e.longRun = (#w >= Config.LongWordLength) and (e.longRun + 1) or 0
			PlayerData.WordPlayed(e.player, w, e.longRun)
			if rare then
				p.rareWords += 1
			end
			local bonusXP = (rare and Config.Reward.BrilliantXP or 0) + (biblical and 25 or 0)
			PlayerData.AddXP(e.player, Config.Reward.WordXP + bonusXP, false)
			if rare then
				PlayerData.AddShards(e.player, Config.Reward.BrilliantShards)
			end
			PlayerData.CheckAchievements(e.player)
			PlayerData.Changed(e.player)
		end
	end

	local wLen = #w
	if wLen >= Config.LongWordLength and not self.firstBigWordDone then
		self.firstBigWordDone = true
		if e.player then
			PlayerData.Reward(e.player, "award", "FIRST BIG WORD", string.upper(w) .. " (" .. wLen .. " letters • First in match)", { coins = 100 })
		end
		self:broadcast("FirstBigWord", { by = e.name, word = w, len = wLen })
	end

	if wLen > self.biggestWordLen then
		self.biggestWordLen = wLen
		self.biggestWord = w
		self.biggestWordPlayer = e.player
		self.biggestWordPlayerName = e.name
	end
	if biblical then
		self:broadcast("Blessed", { word = w, by = e.name })
	elseif rare then
		self:broadcast("Brilliant", { word = w, by = e.name })
	end
	self:broadcast("Played", { word = w, by = e.name, from = old, points = pts, long = #w >= Config.LongWordLength, volley = self.volley, clockFrac = clockFrac, isFast = isFast })

	if self.tutorial and e.kind == "player" and e.words >= Config.TutorialMoves then
		self:pushState()
		self:finish(e.side, "tutorial")
		return
	end
	self.turn = 3 - self.turn
	self:startTurn()
end

function Match:submit(player, raw)
	local e = self.ents[self.turn]
	if not self.active then
		return
	end
	if e.player ~= player then
		local me = self.ents[1].player == player and self.ents[1] or self.ents[2]
		return self:reject(me, "Not your turn.")
	end
	if not self.deadline then
		return self:reject(e, "Get ready - the clock hasn't started.")
	end
	if self.checking then
		return
	end
	local w = WordRules.Normalize(raw)
	if not w or #w < MIN_LEN or #w > MAX_LEN then
		return self:reject(e, "Use a word of " .. MIN_LEN .. " to " .. MAX_LEN .. " letters.")
	end
	if w == self.word then
		return self:reject(e, "Play a different word.")
	end
	if self.used[w] then
		return self:reject(e, string.upper(w) .. " was already played this match.")
	end
	if kept(self.word, w) < 1 then
		return self:reject(e, "Keep at least one letter in the same spot as " .. string.upper(self.word) .. ".")
	end
	if self:hitsLock(w) then
		local shown = {}
		for _, ch in ipairs(self.lockLetters) do
			table.insert(shown, string.upper(ch))
		end
		return self:reject(e, table.concat(shown, " and ") .. (#shown == 1 and " is" or " are") .. " locked this turn - no words with " .. (#shown == 1 and "it" or "them") .. ".")
	end
	if WordRules.IsInflection(self.word, w) then
		return self:reject(e, "Tense or plural of " .. string.upper(self.word) .. " is not allowed.")
	end
	if WordRules.IsSuffixManipulation(self.word, w) then
		return self:reject(e, "Derivative form of " .. string.upper(self.word) .. " is not allowed.")
	end
	if not Dictionary.IsWord(w) then
		return self:reject(e, string.upper(w) .. " is not in the dictionary.")
	end
	self.checking = true
	local token = self.token
	local allowed = Dictionary.IsAllowed(w, player.UserId)
	self.checking = false
	if not self.active or self.token ~= token then
		return
	end
	if not allowed then
		return self:reject(e, "That word is not allowed.")
	end
	if now() > self.deadline + 0.25 then
		return -- too late; timer resolves it
	end
	self:applyMove(e, w)
end

function Match:useItem(player, kind)
	if not self.active then
		return
	end
	local e = self.ents[self.turn]
	local me = self.ents[1].player == player and self.ents[1] or self.ents[2]
	if e ~= me then
		return self:reject(me, "Boosts can only be used on your turn.")
	end
	if not self.deadline then
		return self:reject(me, "Get ready - the clock hasn't started.")
	end
	local slot
	local timeLeft = self.deadline and math.max(0, self.deadline - now()) or 0
	for _, s in ipairs(e.slots) do
		if s.kind == kind then
			if s.state == "locked" and s.fastAt and (timeLeft <= s.fastAt + 0.5 or (self.turnTime and self.turnTime <= s.fastAt)) then
				s.state = "empty"
				if self:canFill(e, s.kind) then
					s.state = "ready"
				end
			end
			if s.state == "ready" then
				slot = s
				break
			end
		end
	end
	if not slot then
		return self:reject(e, "That boost isn't ready yet.")
	end
	local p = PlayerData.Get(player)
	if not self.tutorial and (not p or (p.inventory[kind] or 0) < 1) then
		return self:reject(e, "You don't have any " .. Config.Items[kind].name .. " left.")
	end

	if kind == "Help" then
		if e.helpUsed >= Config.HelpMaxPerMatch then
			return self:reject(e, "Max " .. Config.HelpMaxPerMatch .. " Hints per match.")
		end
		if e.ownTurns - e.lastHelpTurn < Config.HelpCooldownTurns then
			return self:reject(e, "Hint can't be used two turns in a row.")
		end
		local w, pts = self:bestMove()
		if not w then
			return self:reject(e, "No hint available.")
		end
		send(e, "Hint", { word = w, points = pts })
		e.helpUsed += 1
		e.lastHelpTurn = e.ownTurns
	elseif kind == "Time" then
		self.deadline += Config.TimeBoostSeconds
		self.turnTime += Config.TimeBoostSeconds
		Arena.SetTimer(self.table, self.deadline)
	elseif kind == "DoubleShift" then
		if e.doublePoints then
			return self:reject(e, "Double Points is already active.")
		end
		e.doublePoints = true
	elseif kind ~= "Skip" then
		return
	end

	-- consume: the slot starts refilling (free in the tutorial)
	slot.state = "cooldown"
	slot.readyIn = self.tutorial and 1 or Config.ItemRefillTurns
	if not self.tutorial then
		p.inventory[kind] -= 1
		PlayerData.Changed(player)
	end
	self:broadcast("Toast", e.name .. " used " .. Config.Items[kind].name .. "!")

	if kind == "Skip" then
		self.volley += 1
		self.turn = 3 - self.turn
		self:startTurn()
	else
		self:pushState()
	end
end

-- bots ------------------------------------------------------------------------
-- Bots think like people: quick early, slower and more error-prone as the clock shrinks.
-- Stronger bots answer faster, keep more letters (higher scores) and slip less.
-- how long a bot "thinks": a slice of its clock (weaker bots use more of it), always
-- finishing at least 0.6s before its time runs out
function Match:botDelay(e)
	if e.tutorial then
		return 1.4 + math.random() * 0.8
	end
	local t = self.turnTime
	local frac = 0.12 + math.random() ^ 1.6 * (0.4 - 0.25 * e.skill)
	local d = math.max(0.8, t * frac + math.random() * 0.5)
	return math.min(d, t - 0.6)
end

-- chance a bot blanks this turn (how you beat it): grows slowly as the rally speeds up
function Match:botSlipChance(e)
	if e.tutorial then
		return 0
	end
	local slip = math.clamp(0.01 + self.volley * 0.004 - e.skill * 0.02, 0.005, 0.25)
	if not e.disguised then
		slip *= 0.6 -- practice bots are a bit kinder
	end
	return slip
end

function Match:botThink(token)
	local e = self.ents[self.turn]
	if math.random() < self:botSlipChance(e) then
		return -- freezes; the clock decides
	end
	local delay = self:botDelay(e)
	task.delay(delay, function()
		if not self.active or self.token ~= token then
			return
		end
		local w = self:botMove(e)
		if w and self.active and self.token == token then
			self:applyMove(e, w)
		end
	end)
end

function Match:botMove(e)
	local cands = self:candidates()
	if #cands == 0 then
		return nil
	end
	-- people mostly play everyday words; strong players squeeze out more kept letters
	local common = {}
	for _, c in ipairs(cands) do
		if Dictionary.IsCommon(c.w) then
			table.insert(common, c)
		end
	end
	local pool = #common > 0 and common or cands
	-- people mostly stay near the current length (grow or shrink by at most one letter)
	local near = {}
	for _, c in ipairs(pool) do
		if math.abs(#c.w - #self.word) <= 1 then
			table.insert(near, c)
		end
	end
	if #near > 0 then
		pool = near
	end
	local want = 1
	if not e.tutorial then
		local maxPts = 0
		for _, c in ipairs(pool) do
			maxPts = math.max(maxPts, c.pts)
		end
		if math.random() < 0.3 + 0.6 * e.skill then
			want = maxPts
		else
			want = math.random(1, math.max(1, maxPts))
		end
	end
	local pick = {}
	for _, c in ipairs(pool) do
		if c.pts >= want then
			table.insert(pick, c)
		end
	end
	if #pick == 0 then
		pick = pool
	end
	for _ = 1, 8 do
		local c = pick[math.random(#pick)]
		if Dictionary.IsAllowed(c.w) then
			return c.w
		end
	end
	return nil
end

-- ending ------------------------------------------------------------------------
function Match:finish(winnerSide, reason)
	if not self.active then
		return
	end
	self.active = false
	self.token += 1
	local winner, loser = self.ents[winnerSide], self.ents[3 - winnerSide]
	for _, e in ipairs(self.ents) do
		if e.player and Match.ByPlayer[e.player] == self then
			Match.ByPlayer[e.player] = nil
		end
	end
	Arena.SetClock(self.table, 0)
	Arena.SetTimer(self.table, nil)
	-- bot avatars leave with the loser/table reset
	for _, e in ipairs(self.ents) do
		if e.kind == "bot" and e.rig then
			local rig = e.rig
			task.delay(2.6, function()
				if rig.Parent then
					rig:Destroy()
				end
			end)
		end
	end
	if self.onEnd then
		self.onEnd(self, winner, loser, reason)
	end
end

function Match:forfeit(player)
	for _, e in ipairs(self.ents) do
		if e.player == player then
			self:finish(3 - e.side, "left")
			return
		end
	end
end

return Match
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">NPC</string><ProtectedString name="Source"><![CDATA[-- NPC: builds avatar rigs for bot opponents and ambient table duels, plus Roblox-style
-- display names. Names are generated, never taken from real accounts.
local Players = game:GetService("Players")

local NPC = {}

local FIRST = {
	"Pixel", "Lunar", "Mango", "Frosty", "Turbo", "Cosmic", "Sunny", "Shadow", "Minty", "Ziggy",
	"Nova", "Echo", "Blaze", "Coral", "Maple", "Velvet", "Rusty", "Jade", "Ruby", "Storm",
	"Cocoa", "Peachy", "Toasty", "Misty", "Clever", "Lucky", "Sneaky", "Bouncy", "Sleepy", "Zesty",
	"Silent", "Golden", "Crimson", "Hyper", "Chill", "Fuzzy", "Witty", "Brave", "Spicy", "Icy",
}
local SECOND = {
	"Fox", "Panda", "Otter", "Wizard", "Ninja", "Comet", "Bean", "Tiger", "Koala", "Falcon",
	"Pickle", "Noodle", "Penguin", "Rocket", "Llama", "Dragon", "Waffle", "Mochi", "Badger", "Owl",
	"Phoenix", "Raven", "Puffin", "Gecko", "Muffin", "Biscuit", "Taco", "Bunny", "Wolf", "Shark",
	"Scribe", "Speller", "Reader", "Quill", "Ink", "Pages", "Lexi", "Writer", "Riddle", "Puzzler",
}

local used = {}
function NPC.RandomName()
	for _ = 1, 20 do
		local a = FIRST[math.random(#FIRST)]
		local b = SECOND[math.random(#SECOND)]
		local style = math.random(6)
		local name
		if style == 1 then
			name = a .. b .. math.random(2, 999)
		elseif style == 2 then
			name = a .. "_" .. b
		elseif style == 3 then
			name = string.lower(a) .. b .. math.random(1, 99)
		elseif style == 4 then
			name = a .. b
		elseif style == 5 then
			name = b .. "_" .. math.random(10, 9999)
		else
			name = string.lower(a) .. string.lower(b)
		end
		if not used[name] then
			used[name] = true
			return name
		end
	end
	return "Player" .. math.random(1000, 99999)
end

local SKIN = {
	Color3.fromRGB(255, 220, 190), Color3.fromRGB(234, 184, 146), Color3.fromRGB(204, 142, 105),
	Color3.fromRGB(160, 102, 70), Color3.fromRGB(116, 72, 48), Color3.fromRGB(86, 56, 40),
	Color3.fromRGB(245, 205, 48), Color3.fromRGB(255, 235, 210),
}
local SHIRT = {
	Color3.fromRGB(30, 30, 36), Color3.fromRGB(220, 220, 225), Color3.fromRGB(196, 40, 52), Color3.fromRGB(36, 92, 196),
	Color3.fromRGB(40, 140, 90), Color3.fromRGB(240, 170, 40), Color3.fromRGB(120, 60, 170), Color3.fromRGB(240, 120, 160),
	Color3.fromRGB(70, 170, 200), Color3.fromRGB(90, 70, 50), Color3.fromRGB(250, 250, 250), Color3.fromRGB(255, 90, 40),
}
local PANTS = {
	Color3.fromRGB(28, 30, 40), Color3.fromRGB(40, 52, 90), Color3.fromRGB(70, 70, 76), Color3.fromRGB(110, 84, 60),
	Color3.fromRGB(20, 20, 22), Color3.fromRGB(60, 90, 140), Color3.fromRGB(200, 200, 205),
}

local function pick(t)
	return t[math.random(#t)]
end

-- Returns a seated-ready R15 Model, or nil if avatar creation is unavailable.
function NPC.Build(name)
	local desc = Instance.new("HumanoidDescription")
	local skin = pick(SKIN)
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = pick(SHIRT)
	local legs = pick(PANTS)
	desc.LeftLegColor = legs
	desc.RightLegColor = legs
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		return nil
	end
	model.Name = name
	model.Archivable = true
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayName = name
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	end
	model:SetAttribute("WordDuelNPC", true)
	return model
end

return NPC
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">PlayerData</string><ProtectedString name="Source"><![CDATA[-- PlayerData: loads/saves profiles, XP/levels, inventory, achievements, daily streak.
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local PlayerData = {}
PlayerData.OnChanged = nil -- function(player, profile) set by Main
PlayerData.OnToast = nil -- function(player, text) set by Main
PlayerData.OnLevelUp = nil -- function(player, profile) set by Main
PlayerData.OnReward = nil -- function(player, payload) set by Main: the big reward popup

local STORE_NAME = "WordDuel_Profiles_v1"
local store
do
	local ok, res = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = res
	else
		warn("[WordDuel] DataStore unavailable, progress will not save:", res)
	end
end

local profiles = {} -- [player] = profile
local canSave = {} -- [player] = bool (false if load failed, so we never overwrite real data)

local function template()
	local inv = {}
	for k, v in pairs(Config.StartingInventory) do
		inv[k] = v
	end
	return {
		xp = 15, -- Endowed Progress Effect: head start towards Level 2
		level = 1,
		elo = Config.StartElo,
		coins = 0,
		shards = 0,
		wins = 0,
		losses = 0,
		matches = 0,
		curStreak = 0,
		bestStreak = 0,
		wordsPlayed = 0,
		rareWords = 0,
		inventory = inv,
		belt = { "Help", "Time", "Skip" },
		slotsBought = 0,
		achievements = {},
		dailyDay = 0,
		dailyStreak = 0,
		referredBy = 0,
		referralPaid = false,
		tutorialDone = false,
		bestWordLen = 0,
		bestWord = "",
		longWords = 0,
		longStreakBest = 0,
		bestScore = 0,
		totalScore = 0,
		fastPlays = 0,
		ladderDay = 0,
		ladderStreak = 0,
		ladderSteps = 0,
		ladderSolves = 0,
		receipts = {},
	}
end

local function reconcile(data, tmpl)
	for k, v in pairs(tmpl) do
		if data[k] == nil then
			data[k] = v
		elseif type(v) == "table" and type(data[k]) == "table" and k == "inventory" then
			reconcile(data[k], v)
		end
	end
	return data
end

local function key(player)
	return "u_" .. player.UserId
end

function PlayerData.Load(player)
	local data, ok = nil, false
	if store then
		for attempt = 1, 3 do
			local success, res = pcall(function()
				return store:GetAsync(key(player))
			end)
			if success then
				data, ok = res, true
				break
			end
			warn("[WordDuel] load failed", attempt, res)
			task.wait(1.5 * attempt)
		end
	end
	if not player.Parent then
		return nil
	end
	local profile = reconcile(type(data) == "table" and data or template(), template())
	if profile.belt and #profile.belt < 3 then
		profile.belt[2] = profile.belt[2] or "Time"
		profile.belt[3] = profile.belt[3] or "Skip"
	end
	if RunService:IsStudio() then
		profile.tutorialDone = false
		profile.dailyDay = 0
	end
	profiles[player] = profile
	canSave[player] = ok
	if store and not ok then
		PlayerData.Toast(player, "Could not load your save. Progress this session will NOT be saved.")
	end
	return profile
end

-- Returns true when the profile is safely stored. In an unpublished Studio place there is
-- no DataStore at all; that counts as success so purchases can be tested.
function PlayerData.Save(player)
	local profile = profiles[player]
	if not profile then
		return false
	end
	if not store then
		return RunService:IsStudio()
	end
	if not canSave[player] then
		return false
	end
	local success, err
	for attempt = 1, 3 do
		success, err = pcall(function()
			store:UpdateAsync(key(player), function()
				return profile
			end)
		end)
		if success then
			return true
		end
		task.wait(attempt)
	end
	warn("[WordDuel] save failed for", player.Name, err)
	return false
end

-- Studio-only test hook: swap in a fake store (table with GetAsync/UpdateAsync) to test saving.
function PlayerData._UseStoreForTesting(fake)
	if RunService:IsStudio() then
		store = fake
	end
end

function PlayerData.Release(player)
	PlayerData.Save(player)
	profiles[player] = nil
	canSave[player] = nil
end

function PlayerData.Get(player)
	return profiles[player]
end

function PlayerData.Toast(player, text)
	if PlayerData.OnToast then
		PlayerData.OnToast(player, text)
	end
end

function PlayerData.Changed(player)
	local p = profiles[player]
	if p and PlayerData.OnChanged then
		PlayerData.OnChanged(player, p)
	end
end

function PlayerData.Slots(profile)
	return Config.SlotsFor(profile.level, profile.slotsBought)
end

-- grant = { coins = n, Help = n, ... }
function PlayerData.Grant(player, grant, silent)
	local p = profiles[player]
	if not p or not grant then
		return
	end
	local parts = {}
	for k, v in pairs(grant) do
		if k == "coins" then
			p.coins += v
			table.insert(parts, "+" .. v .. " coins")
		elseif Config.Items[k] then
			p.inventory[k] = (p.inventory[k] or 0) + v
			table.insert(parts, "+" .. v .. " " .. Config.Items[k].name)
		end
	end
	if not silent and #parts > 0 and PlayerData.OnReward then
		PlayerData.OnReward(player, { kind = "bonus", title = table.concat(parts, "  "), sub = "Added to your stash", items = parts, grant = grant })
	end
	PlayerData.Changed(player)
	return parts
end

-- Give something AND make it noticed: a big popup with sound on the player's screen.
-- kind: "daily" | "award" | "level" | "record" | "streak" | "shards" | "bonus"
function PlayerData.Reward(player, kind, title, sub, grant)
	local items = grant and PlayerData.Grant(player, grant, true) or {}
	if PlayerData.OnReward then
		PlayerData.OnReward(player, { kind = kind, title = title, sub = sub, items = items, grant = grant })
	end
end

local function statValue(p, stat)
	return p[stat] or 0
end

function PlayerData.CheckAchievements(player)
	local p = profiles[player]
	if not p then
		return
	end
	for _, a in ipairs(Config.Achievements) do
		if not p.achievements[a.id] and statValue(p, a.stat) >= a.goal then
			p.achievements[a.id] = os.time()
			PlayerData.Reward(player, "award", a.name, a.desc, a.reward)
		end
	end
end

function PlayerData.AddXP(player, amount, allowLevelUp)
	if allowLevelUp ~= true then
		allowLevelUp = false
	end
	local p = profiles[player]
	if not p or amount <= 0 then
		return
	end
	if not allowLevelUp then
		local needed = Config.XPToNext(p.level)
		if p.xp + amount >= needed then
			p.xp = math.max(p.xp, needed - 1)
		else
			p.xp += amount
		end
		PlayerData.Changed(player)
		return
	end
	p.xp += amount
	local leveled = false
	local oldSlots = PlayerData.Slots(p)
	while p.xp >= Config.XPToNext(p.level) do
		p.xp -= Config.XPToNext(p.level)
		p.level += 1
		leveled = true
	end
	if leveled then
		local sub = "You're getting stronger"
		if PlayerData.Slots(p) > oldSlots then
			sub = "New boost slot on your belt"
		end
		PlayerData.Reward(player, "level", "LEVEL " .. p.level, sub)
		PlayerData.CheckAchievements(player)
		if PlayerData.OnLevelUp then
			PlayerData.OnLevelUp(player, p)
		end
	end
	PlayerData.Changed(player)
end

-- personal records -------------------------------------------------------------
-- (silent the very first time a stat is set, so a new player isn't spammed)
local function record(player, title, sub)
	PlayerData.Reward(player, "record", title, sub, nil)
end

function PlayerData.CheckScoreRecord(player, score)
	local p = profiles[player]
	if not p or not score or score <= p.bestScore then
		return
	end
	local had = p.bestScore > 0
	p.bestScore = score
	if had then
		record(player, score .. " POINTS", "Best score in one match")
	end
	PlayerData.CheckAchievements(player)
end

-- called for every word a player plays; longRun = their long words in a row this match
function PlayerData.WordPlayed(player, word, longRun)
	local p = profiles[player]
	if not p then
		return
	end
	local len = #word
	if len >= Config.LongWordLength then
		p.longWords += 1
	end
	if len > p.bestWordLen then
		local had = p.bestWordLen >= 3
		p.bestWordLen = len
		p.bestWord = word
		if had then
			record(player, string.upper(word), "Longest word - " .. len .. " letters")
		end
	end
	if longRun > p.longStreakBest then
		p.longStreakBest = longRun
		if longRun >= 2 then
			record(player, longRun .. " IN A ROW", "Long words in a row")
		end
	end
end

-- 5 Brilliant shards -> 1 Help
function PlayerData.AddShards(player, n)
	local p = profiles[player]
	if not p then
		return
	end
	p.shards += n
	while p.shards >= Config.ShardsPerHelp do
		p.shards -= Config.ShardsPerHelp
		p.inventory.Help += 1
		if PlayerData.OnReward then
			PlayerData.OnReward(player, { kind = "shards", title = "+1 HINT", sub = "5 shards combined", items = { "+1 Hint" }, grant = { Help = 1 } })
		end
	end
	PlayerData.Changed(player)
end

-- Daily login streak chest
function PlayerData.Daily(player)
	local p = profiles[player]
	if not p then
		return
	end
	local today = math.floor(os.time() / 86400)
	if p.dailyDay == today then
		return
	end
	if p.dailyDay == today - 1 then
		p.dailyStreak += 1
	else
		p.dailyStreak = 1
	end
	p.dailyDay = today
	local grant = { coins = 50 + 10 * math.min(p.dailyStreak, 10) }
	if p.dailyStreak % 7 == 0 then
		grant.DoubleShift = 1
	elseif p.dailyStreak % 3 == 0 then
		grant.Help = 1
	end
	PlayerData.Reward(player, "daily", "DAY " .. p.dailyStreak, "Come back tomorrow for more", grant)
	PlayerData.CheckAchievements(player)
end

-- autosave loop
task.spawn(function()
	while true do
		task.wait(120)
		for _, plr in ipairs(Players:GetPlayers()) do
			task.spawn(PlayerData.Save, plr)
		end
	end
end)

game:BindToClose(function()
	if RunService:IsStudio() and not store then
		return
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		task.spawn(PlayerData.Save, plr)
	end
	task.wait(3)
end)

return PlayerData
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[-- Shop: Robux Developer Products (unlimited stock in inventory) + coin purchases,
-- Loadout Belt validation, and friend referral rewards.
local MarketplaceService = game:GetService("MarketplaceService")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local PlayerData = require(script.Parent.PlayerData)

local Shop = {}

local function applyProduct(player, product)
	local p = PlayerData.Get(player)
	if not p then
		return false
	end
	if product.slot then
		p.slotsBought = math.max(p.slotsBought, product.slot - 1)
		PlayerData.Changed(player)
		if PlayerData.OnReward then
			PlayerData.OnReward(player, { kind = "level", title = "BOOST SLOT " .. product.slot, sub = "Bring one more boost into every match" })
		end
	else
		PlayerData.Grant(player, product.grant)
	end
	return true
end

function Shop.Buy(player, key)
	local product = Config.ProductByKey(key)
	if not product then
		return
	end
	local p = PlayerData.Get(player)
	if not p then
		return
	end
	if product.slot then
		local slots = PlayerData.Slots(p)
		if slots >= product.slot then
			return PlayerData.Toast(player, "You already have that slot.")
		end
		if slots < product.slot - 1 then
			return PlayerData.Toast(player, "Unlock Belt Slot " .. (product.slot - 1) .. " first.")
		end
	end
	if product.id == 0 then
		if RunService:IsStudio() then
			PlayerData.Toast(player, "[Studio test] Free grant: " .. product.label)
			applyProduct(player, product)
		else
			PlayerData.Toast(player, "This product is not set up yet.")
		end
		return
	end
	MarketplaceService:PromptProductPurchase(player, product.id)
end

function Shop.BuyWithCoins(player, kind)
	local price = Config.CoinPrices[kind]
	local p = PlayerData.Get(player)
	if not price or not p then
		return
	end
	if p.coins < price then
		return PlayerData.Toast(player, "Not enough coins! You have " .. p.coins .. " / " .. price .. " needed. Play duels or top up!")
	end
	p.coins -= price
	PlayerData.Grant(player, { [kind] = 1 })
end

function Shop.BuySlotWithCoins(player, slot)
	local p = PlayerData.Get(player)
	if not p or not slot then
		return
	end
	local price = Config.SlotCoinPrices[slot]
	if not price then
		return PlayerData.Toast(player, "Invalid belt slot.")
	end
	if (slot + #Config.FastSlotClocks) > (Config.AbsoluteMaxSlots or 9) then
		return PlayerData.Toast(player, "Max 9 belt slots reached.")
	end
	local slots = PlayerData.Slots(p)
	if slots >= slot then
		return PlayerData.Toast(player, "You already unlocked Slot " .. slot .. ".")
	end
	if slots < slot - 1 then
		return PlayerData.Toast(player, "Unlock Slot " .. (slot - 1) .. " first.")
	end
	if p.coins < price then
		return PlayerData.Toast(player, "Need " .. price .. " coins (you have " .. p.coins .. "). Play duels or top up!")
	end
	p.coins -= price
	p.slotsBought = math.max(p.slotsBought, slot - 1)
	PlayerData.Changed(player)
	if PlayerData.OnReward then
		PlayerData.OnReward(player, { kind = "level", title = "BELT SLOT " .. slot .. " UNLOCKED!", sub = "Belt permanently upgraded with coins!" })
	end
	PlayerData.Toast(player, "Unlocked Belt Slot " .. slot .. "!")
end

function Shop.SetBelt(player, list)
	local p = PlayerData.Get(player)
	if not p or type(list) ~= "table" then
		return
	end
	local slots = PlayerData.Slots(p) + #Config.FastSlotClocks -- fast-game slots can be set up too
	local belt = {}
	for i = 1, slots do
		local kind = list[i]
		if type(kind) == "string" and Config.Items[kind] then
			belt[i] = kind
		else
			belt[i] = nil
		end
	end
	p.belt = belt
	PlayerData.Changed(player)
end

function Shop.ProcessReceipt(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	local product = Config.ProductById(info.ProductId)
	if not player or not product then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local p = PlayerData.Get(player)
	if not p then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- duplicate receipt guard
	for _, id in ipairs(p.receipts) do
		if id == info.PurchaseId then
			-- already granted this session; confirm only once it is actually saved
			if PlayerData.Save(player) then
				return Enum.ProductPurchaseDecision.PurchaseGranted
			end
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
	end
	if not applyProduct(player, product) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(p.receipts, info.PurchaseId)
	while #p.receipts > 50 do
		table.remove(p.receipts, 1)
	end
	-- Only confirm the purchase once it is saved. If the save fails, Roblox retries the receipt
	-- later; the receipt id above stops a double grant if the retry lands in this same session.
	if not PlayerData.Save(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

MarketplaceService.ProcessReceipt = Shop.ProcessReceipt

---------------------------------------------------------------- referrals
-- Invite launch data = "ref=<inviterUserId>;code=<privateCode>"
-- Both players get Config.ReferralBundle once the invited friend reaches level 3 (blocks alt farming).
local pendingStore
pcall(function()
	pendingStore = DataStoreService:GetDataStore("WordDuel_Referrals_v1")
end)

function Shop.ParseLaunchData(player)
	local ok, joinData = pcall(function()
		return player:GetJoinData()
	end)
	local raw = ok and joinData and joinData.LaunchData
	if type(raw) ~= "string" then
		return nil, nil
	end
	local ref = tonumber(raw:match("ref=(%d+)"))
	local code = raw:match("code=(%w+)")
	return ref, code
end

function Shop.RegisterReferral(player, refId)
	local p = PlayerData.Get(player)
	if not p or not refId or refId == player.UserId then
		return
	end
	if p.referredBy == 0 and p.matches == 0 and p.level < Config.ReferralLevel then
		p.referredBy = refId
		PlayerData.Toast(player, "Invited by a friend! Reach level " .. Config.ReferralLevel .. " and you both get a bonus.")
	end
end

function Shop.CheckReferralPayout(player)
	local p = PlayerData.Get(player)
	if not p or p.referredBy == 0 or p.referralPaid or p.level < Config.ReferralLevel then
		return
	end
	p.referralPaid = true
	PlayerData.Reward(player, "bonus", "FRIEND BONUS", "You and your friend both get this", Config.ReferralBundle)
	local inviter = Players:GetPlayerByUserId(p.referredBy)
	if inviter and PlayerData.Get(inviter) then
		PlayerData.Reward(inviter, "bonus", "FRIEND BONUS", player.DisplayName .. " reached level " .. Config.ReferralLevel, Config.ReferralBundle)
	elseif pendingStore then
		local refKey = "r_" .. p.referredBy
		task.spawn(function()
			pcall(function()
				pendingStore:UpdateAsync(refKey, function(old)
					return (old or 0) + 1
				end)
			end)
		end)
	end
	PlayerData.Save(player)
end

function Shop.ClaimPendingReferrals(player)
	if not pendingStore then
		return
	end
	local claimed = 0
	local ok = pcall(function()
		pendingStore:UpdateAsync("r_" .. player.UserId, function(old)
			claimed = old or 0
			if claimed == 0 then
				return nil -- no write
			end
			return 0
		end)
	end)
	if ok and claimed > 0 then
		local grant = {}
		for k, v in pairs(Config.ReferralBundle) do
			grant[k] = v * claimed
		end
		PlayerData.Reward(player, "bonus", "FRIEND BONUS", claimed .. " friend(s) you invited levelled up", grant)
	end
end

return Shop
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">TestHooks</string><ProtectedString name="Source"><![CDATA[-- TestHooks: Studio-only automated test entry point. Does nothing in a live game.
-- Creates ServerStorage.WordDuelTest (BindableFunction); call :Invoke(command, arg) from the
-- Studio command bar or an MCP tool. Runs inside the game's own module instances, so it sees
-- real matches, profiles and the queue.
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local TestHooks = {}

function TestHooks.Start(deps)
	if not RunService:IsStudio() then
		return
	end
	local Match, Lobby, Dictionary, PlayerData, Config = deps.Match, deps.Lobby, deps.Dictionary, deps.PlayerData, deps.Config
	local Players = game:GetService("Players")

	local sent = {} -- every message the server sends: { to, action, payload }
	local realMatchSend, realLobbySend = Match.Send, Lobby.Send
	local function capture(real)
		return function(p, a, payload)
			table.insert(sent, { to = p, a = a, p = payload })
			if typeof(p) == "Instance" then
				return real(p, a, payload)
			end
		end
	end
	Match.Send = capture(realMatchSend)
	Lobby.Send = capture(realLobbySend)

	local function realPlayer()
		return Players:GetPlayers()[1]
	end

	local fake -- stand-in second player for ranked / friend-table tests
	local function getFake()
		if not fake then
			fake = { UserId = -777, DisplayName = "TestRival", Name = "TestRival", Parent = workspace, Character = nil, __fake = true }
			PlayerData.Load(fake)
		end
		return fake
	end

	local function since(n, kind, who)
		for i = n + 1, #sent do
			local s = sent[i]
			if s.a == kind and (who == nil or s.to == who) then
				return s.p
			end
		end
		return nil
	end

	local function entOf(m, p)
		return m.ents[1].player == p and m.ents[1] or m.ents[2]
	end

	local cmds = {}

	cmds.state = function(who)
		local p = who == "fake" and getFake() or realPlayer()
		local m = Match.ByPlayer[p]
		local prof = PlayerData.Get(p)
		local r = { inMatch = m ~= nil, busy = Lobby.IsBusy(p) }
		if prof then
			r.elo, r.wins, r.losses, r.curStreak, r.bestStreak, r.coins, r.level, r.xp = prof.elo, prof.wins, prof.losses, prof.curStreak, prof.bestStreak, prof.coins, prof.level, prof.xp
			r.inv = prof.inventory
		end
		if m then
			local e = entOf(m, p)
			r.word, r.myTurn, r.ranked, r.private, r.volley = m.word, m.ents[m.turn] == e, m.ranked, m.private, m.volley
			r.left = m.deadline and (m.deadline - workspace:GetServerTimeNow()) or nil
			local names = {}
			for _, sl in ipairs(e.slots or {}) do
				table.insert(names, sl.kind .. ":" .. sl.state)
			end
			r.items = table.concat(names, ",")
			r.score, r.rivalScore = e.score, m:other(e).score
		end
		return r
	end

	cmds.setup = function()
		local prof = PlayerData.Get(realPlayer())
		prof.inventory = { Help = 5, Skip = 5, Time = 5, DoubleShift = 5 }
		prof.slotsBought = 3
		prof.belt = { "Help", "Time", "DoubleShift", "Skip" }
		PlayerData.Changed(realPlayer())
		return "ok"
	end

	cmds.playbot = function()
		Lobby.PlayBot(realPlayer())
		return Match.ByPlayer[realPlayer()] and "started" or "no match"
	end

	local function submitAs(p, word)
		local m = Match.ByPlayer[p]
		if not m then
			return "no match"
		end
		local n = #sent
		m:submit(p, word)
		return since(n, "Invalid", p) or ("accepted -> " .. m.word)
	end

	cmds.submit = function(word)
		return submitAs(realPlayer(), word)
	end

	cmds.goodMove = function(who)
		local p = (type(who) == "table" and who) or (who == "fake" and getFake()) or realPlayer()
		local m = Match.ByPlayer[p]
		if not m then
			return "no match"
		end
		local w = m:bestMove()
		if not w then
			return "no moves"
		end
		return submitAs(p, w)
	end

	cmds.useItem = function(kind)
		local p = realPlayer()
		local m = Match.ByPlayer[p]
		if not m then
			return "no match"
		end
		local e = entOf(m, p)
		local n = #sent
		local d0, t0 = m.deadline, m.turn
		m:useItem(p, kind)
		local inv = since(n, "Invalid", p)
		if inv then
			return "rejected: " .. inv
		end
		local hint = since(n, "Hint", p)
		return string.format("ok hint=%s dt=%.1f double=%s turnPassed=%s helpUsed=%d left=%s", hint and hint.word or "-", (m.deadline or 0) - (d0 or 0), tostring(e.doublePoints), tostring(m.turn ~= t0), e.helpUsed, (function()
			local names = {}
			for _, sl in ipairs(e.slots or {}) do
				table.insert(names, sl.kind .. ":" .. sl.state)
			end
			return table.concat(names, ",")
		end)())
	end

	-- ranked: queue the real player and the fake together
	cmds.ranked = function()
		local f = getFake()
		Lobby.Queue(realPlayer())
		Lobby.Queue(f)
		return "queued both"
	end

	-- fake plays a move whenever it is its turn (or stalls so it loses on time)
	local fakeMode = "off"
	cmds.fakeMode = function(mode)
		fakeMode = mode
		return mode
	end
	task.spawn(function()
		while true do
			task.wait(0.6)
			if fake and fakeMode == "play" then
				local m = Match.ByPlayer[fake]
				if m and m.active and m.ents[m.turn].player == fake then
					pcall(cmds.goodMove, "fake")
				end
			end
		end
	end)

	cmds.lastResult = function(who)
		local p = who == "fake" and getFake() or realPlayer()
		for i = #sent, 1, -1 do
			if sent[i].a == "BoutEnd" and sent[i].to == p then
				return sent[i].p
			end
		end
		return nil
	end

	cmds.lastSent = function(kind)
		for i = #sent, 1, -1 do
			if sent[i].a == kind then
				return { to = typeof(sent[i].to) == "Instance" and sent[i].to.Name or "fake", payload = sent[i].p }
			end
		end
		return nil
	end

	cmds.choice = function(arg)
		local who, choice = arg[1], arg[2]
		local p = who == "fake" and getFake() or realPlayer()
		Lobby.Choice(p, choice)
		return "ok"
	end

	cmds.kingCashOut = function(who)
		local p = who == "fake" and getFake() or realPlayer()
		Lobby.KingCashOut(p)
		return "ok"
	end

	-- friend table: fake hosts, real player joins with the code
	cmds.friend = function()
		local f = getFake()
		local code = Lobby.CreatePrivate(f)
		local n = #sent
		Lobby.JoinPrivate(realPlayer(), code .. " ") -- trailing space: join should still work
		local m = Match.ByPlayer[realPlayer()]
		return string.format("code=%s match=%s private=%s ranked=%s toast=%s", tostring(code), tostring(m ~= nil), tostring(m and m.private), tostring(m and m.ranked), tostring(since(n, "Toast")))
	end

	cmds.queueWhileHosting = function()
		local p = realPlayer()
		local code = Lobby.CreatePrivate(p)
		Lobby.Queue(p)
		local still = Lobby.HostCode(p)
		Lobby.CancelQueue(p)
		return string.format("code=%s stillHostingAfterQueue=%s", tostring(code), tostring(still ~= nil))
	end

	cmds.forfeit = function(who)
		local p = who == "fake" and getFake() or realPlayer()
		local m = Match.ByPlayer[p]
		if m then
			m:forfeit(p)
		end
		return "ok"
	end

	-- saving: round-trip the real profile through an in-memory store
	cmds.saveTest = function()
		local p = realPlayer()
		local mem = {}
		local fail = false
		local mock = {
			GetAsync = function(_, k)
				return mem[k]
			end,
			UpdateAsync = function(_, k, fn)
				if fail then
					error("simulated DataStore outage")
				end
				mem[k] = fn(mem[k])
				return mem[k]
			end,
		}
		PlayerData._UseStoreForTesting(mock)
		local prof = PlayerData.Load(p) -- reload through the store so saving is enabled
		prof.coins = 4321
		prof.inventory.Help = 17
		prof.achievements.first_win = 123
		local savedOk = PlayerData.Save(p)
		-- load into a stand-in with the same UserId
		local twin = { UserId = p.UserId, Parent = workspace, Name = "Twin", DisplayName = "Twin" }
		local loaded = PlayerData.Load(twin)
		local roundTrip = loaded and loaded.coins == 4321 and loaded.inventory.Help == 17 and loaded.achievements.first_win == 123
		PlayerData.Release(twin)
		-- receipts: product grant only confirmed when the save works
		local product = Config.Products[1]
		local oldId = product.id
		product.id = 987654
		local helpBefore = prof.inventory.Help
		local r1 = deps.Shop.ProcessReceipt({ PlayerId = p.UserId, ProductId = 987654, PurchaseId = "test-1" })
		local helpAfter1 = prof.inventory.Help
		local r2 = deps.Shop.ProcessReceipt({ PlayerId = p.UserId, ProductId = 987654, PurchaseId = "test-1" })
		local helpAfter2 = prof.inventory.Help
		fail = true
		local r3 = deps.Shop.ProcessReceipt({ PlayerId = p.UserId, ProductId = 987654, PurchaseId = "test-2" })
		fail = false
		product.id = oldId
		PlayerData._UseStoreForTesting(nil)
		PlayerData.Load(p) -- give the Studio player a clean profile again
		PlayerData.Changed(p)
		return string.format(
			"save=%s roundTrip=%s | receipt1=%s help %d->%d | duplicate=%s help=%d | saveFails=%s",
			tostring(savedOk), tostring(roundTrip), tostring(r1), helpBefore, helpAfter1, tostring(r2), helpAfter2, tostring(r3)
		)
	end

	cmds.studioBuy = function(key)
		local Shop = deps.Shop
		local p = realPlayer()
		local prof = PlayerData.Get(p)
		local before = prof.slotsBought
		Shop.Buy(p, key)
		return "slotsBought " .. before .. " -> " .. prof.slotsBought .. " slots=" .. PlayerData.Slots(prof)
	end

	-- force a letter lock on the real player's next turn (to look at the lock UI)
	cmds.forceLock = function()
		local p = realPlayer()
		local m = Match.ByPlayer[p]
		if not m then
			return "no match"
		end
		local e = entOf(m, p)
		m.ents[1].level, m.ents[2].level = 40, 40
		m.volley = math.max(m.volley, Config.LetterLockVolley + 1)
		local old = Config.LetterLockChance
		Config.LetterLockChance = 1
		m.lockRun, m.lockCooldown = 0, 0
		m.turn = e.side
		m:startTurn()
		Config.LetterLockChance = old
		return "locked " .. table.concat(m.lockLetters or {}, ",") .. " on " .. m.word
	end

	cmds.cleanup = function()
		if fake then
			Lobby.PlayerLeft(fake)
			fakeMode = "off"
		end
		local m = Match.ByPlayer[realPlayer()]
		if m then
			m:forfeit(realPlayer())
		end
		return "ok"
	end

	-- ONE call, compact answer: logic + simulated matches + tutorial + backfill + saving.
	-- Returns "PASS n/n" or "FAIL k/n" plus the failing checks. Takes about 10 seconds.
	cmds.runAll = function()
		local WordRules = require(game:GetService("ReplicatedStorage").Shared.WordRules)
		local Ambient = deps.Ambient
		local Arena = deps.Arena
		local results, fails = 0, {}
		local function check(name, cond, detail)
			results += 1
			if not cond then
				table.insert(fails, name .. (detail and (" (" .. tostring(detail) .. ")") or ""))
			end
		end
		local function newFake(id, name)
			local f = { UserId = id, DisplayName = name, Name = name, Parent = workspace, Character = nil, __fake = true }
			PlayerData.Load(f)
			return f
		end

		-- words + rules
		check("normalize", WordRules.Normalize("  CaT ") == "cat")
		check("diff", (WordRules.Diff("cat", "bat")) == 1)
		check("CAT->CATER = 5", select(2, WordRules.Points("cat", "cater")) == 5)
		check("CATER->CAT = 3", select(2, WordRules.Points("cater", "cat")) == 3)
		check("TREAD->STEAL = 2", select(2, WordRules.Points("tread", "steal")) == 2)
		check("plural/past banned", WordRules.IsInflection("cat", "cats") and WordRules.IsInflection("box", "boxes") and WordRules.IsInflection("bake", "baked") and WordRules.IsInflection("jump", "jumped") and WordRules.IsInflection("try", "tries") and WordRules.IsInflection("try", "tried") and WordRules.IsInflection("stop", "stopped"))
		check("real changes allowed", not WordRules.IsInflection("cat", "cater") and not WordRules.IsInflection("cats", "rats") and not WordRules.IsInflection("cat", "cast"))
		check("long words", Dictionary.IsWord("elephant") and Dictionary.IsWord("submarine"))
		check("word box", Dictionary.IsWord("box"))
		check("non-word xum", not Dictionary.IsWord("xum"))
		check("blocked word", not Dictionary.IsWord("ass") and not Dictionary.IsWord("shit"))
		local badStart
		for len = 3, 6 do
			for _ = 1, 25 do
				local w = Dictionary.StartWord(len)
				if #w ~= len or not Dictionary.IsCommon(w) then
					badStart = w
				end
			end
		end
		check("start words common", badStart == nil, badStart)
		check("bot picks common", Dictionary.IsCommon(Dictionary.PickMove("cat", 1, { cat = true }, nil) or ""))
		check("clock starts at StartTurnTime", Config.TurnTime(0) == Config.StartTurnTime)
		local T = Config.TurnTime
		check("clock speed-up eases off", (T(0) - T(1)) > (T(20) - T(21)) and (T(20) - T(21)) > (T(60) - T(61)) and (T(60) - T(61)) > 0)
		check("clock never below floor", T(500) >= Config.MinTurnTime and T(500) < Config.MinTurnTime + 0.01)
		check("higher level starts faster", Config.StartClockForLevel(30) < Config.StartClockForLevel(1) and Config.StartClockForLevel(500) == Config.StartTurnTimeMin)
		check("King keeps momentum", math.abs(Config.KingStartClock(5, 1) - (5 + Config.KingMomentumBonus)) < 0.01 and Config.KingStartClock(3.6, 1) >= Config.MinTurnTime + 1.5)
		local ambientCount = 0
		for _, t in ipairs(Arena.Tables) do
			if Ambient.IsRunning(t) then
				ambientCount += 1
			end
		end
		check("hall has NPC duels", ambientCount >= 3, ambientCount)

		-- fast simulated ranked match between two fake players (the TREAD -> STEAL -> CREED example)
		local fa, fb = newFake(-9001, "TesterA"), newFake(-9002, "TesterB")
		local tbl = Arena.FreeTable()
		Ambient.Stop(tbl)
		local ended
		local function onEnd(_, w, l, why)
			ended = { winner = w, loser = l, reason = why }
		end
		local m = Match.new(tbl, Match.PlayerEntity(fa), Match.PlayerEntity(fb), { ranked = true, word = "tread", onEnd = onEnd })
		check("ranked people", m.ranked == true)
		check("early move blocked", submitAs(fa, "steal"):find("Get ready") ~= nil)
		task.wait(1.6)
		check("A plays STEAL", submitAs(fa, "steal") == "accepted -> steal")
		check("STEAL scores 2", m.ents[1].score == 2, m.ents[1].score)
		check("not your turn", submitAs(fa, "creed"):find("Not your turn") ~= nil)
		check("repeat blocked", submitAs(fb, "tread"):find("already played") ~= nil)
		check("needs a kept letter", submitAs(fb, "abhor"):find("same spot") ~= nil)
		check("too short", submitAs(fb, "st"):find("3 to 10") ~= nil)
		check("dictionary", submitAs(fb, "stxxx"):find("dictionary") ~= nil)
		check("B plays CREED", submitAs(fb, "creed"):find("accepted") ~= nil)
		check("CREED scores 1", m.ents[2].score == 1, m.ents[2].score)
		check("clock speeds up", m.turnTime == Config.TurnTime(2) and Config.TurnTime(2) < Config.TurnTime(0), m.turnTime)
		check("state has scores", m:stateFor(m.ents[1]).myScore == 2 and m:stateFor(m.ents[1]).rivalScore == 1)
		check("state has used list", #m:stateFor(m.ents[1]).used == 3)
		local bw = m:bestMove()
		check("hint keeps letters", bw and Match.kept(m.word, bw) >= 1, bw)
		-- Double Points item
		local pa = PlayerData.Get(fa)
		pa.inventory.DoubleShift = 1
		m.ents[1].slots = { { kind = "DoubleShift", state = "ready", readyIn = 0 } }
		m:useItem(fa, "DoubleShift")
		local before = m.ents[1].score
		local dw = m:bestMove()
		submitAs(fa, dw)
		check("double points", m.ents[1].score - before == 2 * select(2, WordRules.Points("creed", dw)), m.ents[1].score - before)
		m:forfeit(fb)
		check("forfeit ends match", ended and ended.reason == "left" and ended.winner.player == fa, ended and ended.reason)
		tbl.busy = false

		-- any length: CAT -> CATER scores 5, plurals/past tense refused
		local tblC = Arena.FreeTable()
		Ambient.Stop(tblC)
		ended = nil
		local mc = Match.new(tblC, Match.PlayerEntity(fa), Match.PlayerEntity(fb), { ranked = false, word = "cat", onEnd = onEnd })
		task.wait(1.6)
		check("CATS refused", submitAs(fa, "cats"):find("plurals") ~= nil)
		check("CATER accepted", submitAs(fa, "cater") == "accepted -> cater")
		check("CATER scores 5", mc.ents[1].score == 5, mc.ents[1].score)
		check("CATERED refused", submitAs(fb, "catered"):find("past tense") ~= nil)
		check("shorter word ok", submitAs(fb, "care"):find("accepted") ~= nil and mc.ents[2].score == 3, mc.ents[2].score)
		local bwc = mc:bestMove()
		check("hint is legal", bwc and Match.kept("care", bwc) >= 1 and not WordRules.IsInflection("care", bwc), bwc)
		mc:forfeit(fb)
		tblC.busy = false

		-- letter locks: only at high level once the rally is fast
		local tblL = Arena.FreeTable()
		Ambient.Stop(tblL)
		local ml = Match.new(tblL, Match.PlayerEntity(fa), Match.PlayerEntity(fb), { ranked = false, word = "planter", onEnd = function() end })
		task.wait(1.6)
		ml.volley = 2
		check("no locks early/low level", not ml:locksAllowed())
		ml.ents[1].level, ml.ents[2].level = 40, 40
		ml.volley = Config.LetterLockVolley + 5
		check("locks allowed when fast + high level", ml:locksAllowed())
		local oldChance = Config.LetterLockChance
		Config.LetterLockChance = 1
		ml.lockRun, ml.lockCooldown = 0, 0
		ml:updateLocks()
		local L = ml.lockLetters
		check("lock picks 1-2 letters from the word", L and #L >= 1 and #L <= 2 and string.find("planter", L[1], 1, true) ~= nil, L and table.concat(L, ","))
		check("lock leaves enough moves", L and #ml:candidates() >= Config.LetterLockMinMoves)
		local lockedMoveOk = true
		for _, c in ipairs(ml:candidates()) do
			if ml:hitsLock(c.w) then
				lockedMoveOk = false
			end
		end
		check("bots/Help never use locked letters", lockedMoveOk and (ml:bestMove() == nil or not ml:hitsLock(ml:bestMove())))
		if L then
			-- find a real word that uses a locked letter and otherwise would be legal
			local bad
			for _, c in ipairs((function()
				local saved = ml.lockLetters
				ml.lockLetters = nil
				local all = ml:candidates()
				ml.lockLetters = saved
				return all
			end)()) do
				if ml:hitsLock(c.w) then
					bad = c.w
					break
				end
			end
			ml.turn = 1
			check("locked letter refused", bad and submitAs(fa, bad):find("locked") ~= nil, bad)
		end
		-- a spell lasts a few turns, then cools down
		local runs = 0
		for _ = 1, 12 do
			ml:updateLocks()
			if ml.lockLetters then
				runs += 1
			end
		end
		check("locks come and go", runs > 0 and runs < 12, runs)
		Config.LetterLockChance = oldChance
		ml:forfeit(fa)
		tblL.busy = false

		-- power-up slots: fast-game slots open when the clock gets short; used slots refill
		-- slowly, and only from what you own
		local tblP = Arena.FreeTable()
		Ambient.Stop(tblP)
		local mp = Match.new(tblP, Match.PlayerEntity(fa), Match.PlayerEntity(fb), { ranked = false, word = "stone", onEnd = function() end })
		task.wait(1.6)
		local pe = mp.ents[1]
		local prof = PlayerData.Get(fa)
		prof.inventory.Time = 1
		pe.slots = { { kind = "Time", state = "empty", readyIn = 0 }, { kind = "Time", state = "locked", fastAt = 7, readyIn = 0 } }
		mp.turnTime = 12
		mp:refreshSlots(pe, true)
		check("open slot fills from what you own", pe.slots[1].state == "ready" and pe.slots[2].state == "locked")
		mp.turnTime = 6.5
		mp:refreshSlots(pe, true)
		check("fast slot opens but stays empty if you own too few", pe.slots[2].state == "empty", pe.slots[2].state)
		prof.inventory.Time = 2
		mp:refreshSlots(pe, false)
		check("owning more fills the slot", pe.slots[2].state == "ready")
		mp.turn = 1
		mp:useItem(fa, "Time")
		check("using a power-up starts its refill", pe.slots[1].state == "cooldown" and pe.slots[1].readyIn == Config.ItemRefillTurns and prof.inventory.Time == 1)
		for _ = 1, Config.ItemRefillTurns - 1 do
			mp:refreshSlots(pe, true)
		end
		check("refill takes a few turns", pe.slots[1].state == "cooldown")
		mp:refreshSlots(pe, true)
		check("refills only from what you own", pe.slots[1].state == "empty" and pe.slots[2].state == "ready", pe.slots[1].state)
		prof.inventory.Time = 3
		mp:refreshSlots(pe, false)
		check("refills when you have more", pe.slots[1].state == "ready")
		mp:forfeit(fa)
		tblP.busy = false

		-- clock timeout still eliminates
		ended = nil
		local tblT = Arena.FreeTable()
		Ambient.Stop(tblT)
		ended = nil
		local mt = Match.new(tblT, Match.PlayerEntity(fa), Match.PlayerEntity(fb), { ranked = true, word = "pin", onEnd = onEnd })
		task.wait(1.6)
		mt.deadline = workspace:GetServerTimeNow() + 0.15
		mt:armTimer(mt.token)
		task.wait(0.5)
		check("timeout ends match", ended and ended.reason == "timeout" and ended.winner.player == fb, ended and ended.reason)
		tblT.busy = false

		-- hidden bot: looks like a player, has a seated avatar
		local fc = newFake(-9003, "TesterC")
		local tbl2 = Arena.FreeTable()
		Ambient.Stop(tbl2)
		local n0 = #sent
		local bot = Match.BotEntity(3, { disguised = true, elo = 1100 })
		local m2 = Match.new(tbl2, Match.PlayerEntity(fc), bot, { ranked = true, onEnd = function() end })
		local start = since(n0, "MatchStart", fc)
		check("bot hidden", start and start.opp.isBot == false)
		check("bot name human", not bot.name:find("Bot") and not bot.name:find("Practice"), bot.name)
		check("bot has avatar", bot.rig ~= nil and bot.rig.Parent ~= nil)
		check("bot match ranked", m2.ranked == true)
		local bm = m2:botMove(m2.ents[2])
		check("bot plays legal words", bm and Match.kept(m2.word, bm) >= 1 and Dictionary.IsWord(bm), bm)
		m2:forfeit(fc)
		tbl2.busy = false

		-- bots answer inside their clock (both at the start and at the 3.5s floor)
		local lateBot, slowest = nil, 0
		for _, t in ipairs({ Config.StartTurnTime, Config.MinTurnTime }) do
			for _, skill in ipairs({ 0.05, 0.5, 0.95 }) do
				local fakeMatch = setmetatable({ turnTime = t, volley = 0 }, Match)
				for _ = 1, 200 do
					local d = fakeMatch:botDelay({ skill = skill, disguised = true })
					slowest = math.max(slowest, d / t)
					if d > t - 0.5 or d < 0.5 then
						lateBot = string.format("t=%.1f skill=%.2f d=%.2f", t, skill, d)
					end
				end
			end
		end
		check("bots answer in time", lateBot == nil, lateBot)
		local slipMatch = setmetatable({ turnTime = 12, volley = 10 }, Match)
		check("bots rarely freeze", slipMatch:botSlipChance({ skill = 0.5, disguised = true }) < 0.1)

		-- tutorial, queue backfill and the automatic King run in parallel (each takes a few seconds)
		local learner, waiter = newFake(-9004, "Learner"), newFake(-9005, "Waiter")
		local kingA, kingB = newFake(-9006, "KingA"), newFake(-9007, "KingB")
		local tutDone, fillMatch, kingResult
		task.spawn(function()
			-- two people queue -> ranked match; one times out; the winner stays on as King
			-- automatically and a challenger sits down on the same word without any button
			Lobby.Queue(kingA)
			Lobby.Queue(kingB)
			local km
			for _ = 1, 40 do
				km = Match.ByPlayer[kingA]
				if km then
					break
				end
				task.wait(0.1)
			end
			if not km then
				kingResult = "no ranked match"
				return
			end
			task.wait(1.6)
			km.deadline = workspace:GetServerTimeNow() + 0.1
			km:armTimer(km.token)
			task.wait(0.4)
			local loserSide = km.turn
			local winnerP = km.ents[3 - loserSide].player
			local lastWord = km.word
			for _ = 1, 60 do
				local nm = Match.ByPlayer[winnerP]
				if nm and nm ~= km then
					kingResult = (nm.word == lastWord and nm.ranked) and "ok" or ("wrong match " .. tostring(nm.word))
					nm:forfeit(winnerP)
					return
				end
				task.wait(0.1)
			end
			kingResult = "no challenger"
		end)
		task.spawn(function()
			Lobby.StartTutorial(learner)
			local tm = Match.ByPlayer[learner]
			if not tm then
				return
			end
			for _ = 1, 120 do
				if not tm.active then
					break
				end
				if tm.ents[tm.turn].player == learner and tm.deadline then
					pcall(cmds.goodMove, learner)
				end
				task.wait(0.15)
			end
			tutDone = PlayerData.Get(learner).tutorialDone
		end)
		task.spawn(function()
			PlayerData.Get(waiter).level = 40 -- far from the King testers so the two tests never pair up
			Lobby.Queue(waiter)
			for _ = 1, 100 do
				local qm = Match.ByPlayer[waiter]
				if qm then
					fillMatch = qm
					break
				end
				task.wait(0.1)
			end
		end)
		for _ = 1, 140 do
			if tutDone ~= nil and fillMatch and kingResult then
				break
			end
			task.wait(0.1)
		end
		check("King continues automatically", kingResult == "ok", kingResult)
		check("tutorial completes", tutDone == true)
		check("tutorial reward", PlayerData.Get(learner).coins >= Config.TutorialReward.coins)
		check("queue backfilled", fillMatch ~= nil)
		check("backfill ranked + hidden", fillMatch and fillMatch.ranked and fillMatch.ents[2].disguised)
		if fillMatch then
			fillMatch:forfeit(waiter)
		end

		-- records + awards for long words and scores, each announced with a reward popup
		local popups = {}
		local realOnReward = PlayerData.OnReward
		PlayerData.OnReward = function(plr, payload)
			if plr == fa then
				table.insert(popups, payload)
			end
			if realOnReward then
				realOnReward(plr, payload)
			end
		end
		local pr = PlayerData.Get(fa)
		pr.bestWordLen, pr.longWords, pr.longStreakBest, pr.bestScore, pr.achievements = 4, 0, 0, 10, {}
		PlayerData.WordPlayed(fa, "elephant", 1)
		PlayerData.WordPlayed(fa, "triangle", 2)
		PlayerData.CheckAchievements(fa)
		PlayerData.CheckScoreRecord(fa, 31)
		PlayerData.OnReward = realOnReward
		check("longest word record", pr.bestWordLen == 8 and pr.bestWord == "elephant")
		check("long words counted", pr.longWords == 2 and pr.longStreakBest == 2)
		check("best score record", pr.bestScore == 31)
		check("long-word awards", pr.achievements.word_8 ~= nil and pr.achievements.score_30 ~= nil)
		local kinds = {}
		for _, r in ipairs(popups) do
			kinds[r.kind] = (kinds[r.kind] or 0) + 1
		end
		check("reward popups sent", (kinds.record or 0) >= 3 and (kinds.award or 0) >= 2, game:GetService("HttpService"):JSONEncode(kinds))

		-- saving and receipts
		local save = cmds.saveTest()
		check("save + receipts", save:find("save=true roundTrip=true") and save:find("duplicate=Enum.ProductPurchaseDecision.PurchaseGranted help=20") and save:find("saveFails=Enum.ProductPurchaseDecision.NotProcessedYet"), save)

		for _, f in ipairs({ fa, fb, fc, learner, waiter, kingA, kingB }) do
			Lobby.PlayerLeft(f)
			PlayerData.Release(f)
		end
		local passed = results - #fails
		return (#fails == 0 and "PASS " or "FAIL ") .. passed .. "/" .. results .. (#fails > 0 and (": " .. table.concat(fails, "; ")) or "")
	end

	local bf = ServerStorage:FindFirstChild("WordDuelTest") or Instance.new("BindableFunction")
	bf.Name = "WordDuelTest"
	bf.OnInvoke = function(cmd, arg)
		local f = cmds[cmd]
		if not f then
			return "unknown command " .. tostring(cmd)
		end
		local ok, res = pcall(f, arg)
		if not ok then
			return "ERROR " .. tostring(res)
		end
		return res
	end
	bf.Parent = ServerStorage
	print("[WordDuel] Studio test hooks ready (ServerStorage.WordDuelTest)")
end

return TestHooks
